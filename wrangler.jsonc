{
  // Cloudflare Workers static assets for the wasm build of 2048.
  // `pnpm run build:web` writes dist/web/ (index.html picker, worker.js,
  // program.wasm plus per-machine skins, program.json sidecars, _headers).
  // The _headers file sets COOP/COEP so SharedArrayBuffer / waitFrame()
  // work in the browser.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "2048",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist/web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "2048.8bitscript.com",
      "custom_domain": true
    }
  ]
}
