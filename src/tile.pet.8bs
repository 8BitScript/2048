// The PET's own tile: a solid block of quadrant-block pseudo-pixels with
// the value cut into it in inverted PET block-digits, instead of the
// portable tile.8bs's reverse-video text field. Picked up automatically
// for PET builds only — nothing in main.8bs or 8bs.config.ts names this
// file; see docs/packages.md's "System-specific files" and tile.8bs's own
// header comment for why a PET version exists at all.
//
// Why the PET needs a different tile at all: text.printNumber's centring
// (see tile.8bs) is exact only when cellWidth - digitWidth is even, and a
// 1-character-wide digit makes that parity flip between 1-, 2-, 3- and
// 4-digit tiles — there is no cellWidth that centres all four. A PET
// quadrant-block digit is 2 cells wide, so the same leftover is always
// even, and every digit count from "2" to "2048" centres exactly. That
// gain is PET-only: it is the one target with a fixed-glyph ROM whose
// quadrant-block characters (see packages/pet/AGENTS.md) turn into a
// font at all; no portable `blocks` capability exists to draw the same
// thing on the other eight.
//
// The font here is the inverted form of @8bitscript/pet/blocks's own
// DIGIT_TILES (bit 7 flipped): drawn over a solid reverse-video tile,
// that is dark ink cut into the tile rather than a fresh glyph punching
// a black rectangle through it. Kept as data in this file so the game
// never links digits.print / printCentered / patternIndex — 2048 only
// ever stamps the eleven face values below.
//
// The HUD is the same idea one layer up. text.print / printNumber /
// asciiToScreenCode are a portable conversion pipeline this file does
// not need: every PET's graphics set puts A–Z at screen codes 1–26
// (both character ROMs; packages/pet/AGENTS.md), digits and space sit
// at their ASCII values, and the VIA PCR ($E84C) is one store. A loop
// over baked codes is smaller than linking the converter, and it is
// what lets a stock 4K 2001's ~3K of usable RAM hold the game.
import { Input, System, Video } from "@8bitscript/system";

const ROW: usmallint = Video.COLUMNS; // 40, or 80 on an 8032 build

const TILE_H: utinyint = 5;

// Screen code 160 is all four quadrants on — the same reverse-space a
// filled tile is. Written directly so fillTile is a store, not a call
// into text.print (five prints of eight spaces cost more than this loop).
const SOLID: utinyint = 160;

// VIA PCR: $0C selects the graphics character set. A–Z are then screen
// codes 1–26 on every PET, including the 2001's swapped text ROM, so
// the HUD table below is one table rather than two.
const GRAPHICS_SET: utinyint = 0x0C;
const VIA_PCR: usmallint = 0xE84C;
const SCREEN: usmallint = 0x8000;

// Decimal digits of 2^exponent, packed without the trailing zeros a
// four-wide slot would carry, and a 13-entry offset table so count is
// `TILE_DIGIT_AT[e+1] - TILE_DIGIT_AT[e]`. Pad is 4 − count (TILE_W is 8,
// a digit is 2 cells, leftover is always even).
const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];

// Inverted 2×3-cell glyphs for digits 0-9, six screen codes each, matching
// @8bitscript/pet/blocks's DIGIT_TILES with bit 7 flipped. Index is digit×6.
const DIGIT_TILES: array<utinyint, 60> = [
    108, 225, 225, 225, 124, 225,
    126, 160, 123, 160, 126, 251,
    98,  225, 226, 225, 124, 251,
    98,  225, 226, 225, 226, 225,
    225, 225, 124, 225, 160, 225,
    108, 254, 124, 251, 226, 225,
    108, 254, 124, 251, 124, 225,
    98,  225, 160, 225, 160, 225,
    108, 225, 124, 225, 124, 225,
    108, 225, 124, 225, 226, 225,
];

// Graphics-set screen codes for the HUD. Header is 12, each status line
// is 19 (the longest message, padded so a shorter one never leaves a
// leftover glyph). A=1 … Z=26, digits and space unchanged.
const HUD: array<utinyint, 69> = [
    50, 48, 52, 56, 32, 32, 19, 3, 15, 18, 5, 32,
    1, 18, 18, 15, 23, 19, 32, 20, 15, 32, 13, 15, 22, 5, 32, 32, 32, 32, 32,
    25, 15, 21, 32, 13, 1, 4, 5, 32, 50, 48, 52, 56, 32, 32, 32, 32, 32, 32,
    7, 1, 13, 5, 32, 15, 22, 5, 18, 32, 45, 32, 18, 5, 19, 20, 1, 18, 20,
];
const HUD_HEADER: utinyint = 0;
const HUD_ARROWS: utinyint = 12;
const HUD_WON: utinyint = 31;
const HUD_OVER: utinyint = 50;
const HUD_HEADER_LEN: utinyint = 12;
const HUD_STATUS_LEN: utinyint = 19;

// Title screen — keep TITLE_AT_VERSION in sync with package.json "version".
const TITLE_DATA: array<utinyint, 44> = [
    50, 48, 52, 56,
    16, 18, 5, 19, 19, 32, 18, 5, 20, 21, 18, 14,
    16, 18, 5, 19, 19, 32, 5, 14, 20, 5, 18,
    16, 18, 5, 19, 19, 32, 19, 20, 1, 18, 20,
    118, 48, 46, 49, 46, 51,
];
const TITLE_AT_2048: utinyint = 0;
const TITLE_AT_PRESS_RETURN: utinyint = 4;
const TITLE_AT_PRESS_ENTER: utinyint = 16;
const TITLE_AT_PRESS_START: utinyint = 27;
const TITLE_AT_VERSION: utinyint = 38;
const TITLE_2048_LEN: utinyint = 4;
const TITLE_PRESS_RETURN_LEN: utinyint = 12;
const TITLE_PRESS_ENTER_LEN: utinyint = 11;
const TITLE_PRESS_START_LEN: utinyint = 11;
const TITLE_VERSION_LEN: utinyint = 6;

const SCORE_PLACES: array<usmallint, 5> = [10000, 1000, 100, 10, 1];

// Top-left cell of each board square. Compile-time data: (1 + row×6)×
// columns + leftMargin + col×9. The unused table is pruned, and an index
// is smaller than the 16-bit multiply that would recompute it.
const ORIGIN_40: array<usmallint, 16> = [
    42, 51, 60, 69,
    282, 291, 300, 309,
    522, 531, 540, 549,
    762, 771, 780, 789,
];
const ORIGIN_80: array<usmallint, 16> = [
    102, 111, 120, 129,
    582, 591, 600, 609,
    1062, 1071, 1080, 1089,
    1542, 1551, 1560, 1569,
];

// Layout is a property of the build (40 vs 80 columns), so computeLayout
// has nothing to work out at run time — an empty body is deleted, and
// main()'s call to it costs the PET nothing.
export function computeLayout(): void {
}

function writeCells(cell: usmallint, base: utinyint, count: utinyint): void {
    let i: utinyint = 0;
    while (i < count) {
        memory.write(SCREEN + cell + i, HUD[base + i]);
        i++;
    }
    return;
}

function writeTitleCells(cell: usmallint, base: utinyint, count: utinyint): void {
    let i: utinyint = 0;
    while (i < count) {
        memory.write(SCREEN + cell + i, TITLE_DATA[base + i]);
        i++;
    }
    return;
}

function printScore5(cell: usmallint, value: usmallint): void {
    let i: utinyint = 0;
    while (i < 5) {
        let digit: utinyint = 48;
        while (value >= SCORE_PLACES[i]) {
            value = value - SCORE_PLACES[i];
            digit++;
        }
        memory.write(SCREEN + cell + i, digit);
        i++;
    }
    return;
}

export function drawTitleScreen(): void {
    memory.write(VIA_PCR, GRAPHICS_SET);
    let cols: usmallint = Video.COLUMNS;
    let rowWidth: usmallint = ROW;
    let titleRow: utinyint = (Video.ROWS >> 1) - 1;
    let promptRow: utinyint = titleRow + 2;
    let versionRow: utinyint = Video.ROWS - 1;
    writeTitleCells(
        titleRow * rowWidth + ((cols - TITLE_2048_LEN) >> 1),
        TITLE_AT_2048,
        TITLE_2048_LEN,
    );
    if (!Input.KEYBOARD) {
        writeTitleCells(
            promptRow * rowWidth + ((cols - TITLE_PRESS_START_LEN) >> 1),
            TITLE_AT_PRESS_START,
            TITLE_PRESS_START_LEN,
        );
    } else if (#system() == System.WEB) {
        writeTitleCells(
            promptRow * rowWidth + ((cols - TITLE_PRESS_ENTER_LEN) >> 1),
            TITLE_AT_PRESS_ENTER,
            TITLE_PRESS_ENTER_LEN,
        );
    } else {
        writeTitleCells(
            promptRow * rowWidth + ((cols - TITLE_PRESS_RETURN_LEN) >> 1),
            TITLE_AT_PRESS_RETURN,
            TITLE_PRESS_RETURN_LEN,
        );
    }
    writeTitleCells(
        versionRow * rowWidth + cols - TITLE_VERSION_LEN,
        TITLE_AT_VERSION,
        TITLE_VERSION_LEN,
    );
    return;
}

export function drawHud(score: usmallint, over: bool, won: bool): void {
    memory.write(VIA_PCR, GRAPHICS_SET);
    let headerAt: usmallint = 2;
    let statusAt: usmallint = 962;
    if (Video.COLUMNS != 40) {
        headerAt = 22;
        statusAt = 1942;
    }
    writeCells(headerAt, HUD_HEADER, HUD_HEADER_LEN);
    printScore5(headerAt + HUD_HEADER_LEN, score);
    let msg: utinyint = HUD_ARROWS;
    if (won) {
        msg = HUD_WON;
    }
    if (over) {
        msg = HUD_OVER;
    }
    writeCells(statusAt, msg, HUD_STATUS_LEN);
    return;
}

function fillTile(origin: usmallint): void {
    let rowCell: usmallint = origin;
    let row: utinyint = 0;
    while (row < TILE_H) {
        let col: utinyint = 0;
        while (col < 8) {
            memory.write(SCREEN + rowCell + col, SOLID);
            col++;
        }
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        memory.write(SCREEN + rowCell, DIGIT_TILES[base]);
        memory.write(SCREEN + rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let cell: utinyint = row * 4 + col;
    let origin: usmallint = ORIGIN_40[cell];
    if (Video.COLUMNS != 40) {
        origin = ORIGIN_80[cell];
    }
    fillTile(origin);
    let base: utinyint = TILE_DIGIT_AT[exponent];
    let count: utinyint = TILE_DIGIT_AT[exponent + 1] - base;
    if (count != 0) {
        let at: usmallint = origin + ROW + (4 - count);
        let i: utinyint = 0;
        while (i < count) {
            drawDigit(at, TILE_DIGIT[base + i]);
            at = at + 2;
            i++;
        }
    }
    return;
}
