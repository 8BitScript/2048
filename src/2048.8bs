// 2048 — for every 8BitScript target: VIC-20, C64, PET, C128, Atari 8-bit,
// NES, Commander X16, MEGA65, and the web. This is the program: the loop
// that reads the player and drives the game. The rules and the board are
// lib/game.8bs's, what goes on the screen is ui/'s — App.8bx is the root —
// and what each machine paints it with is lib/tile.8bs's (and its twins').
// Rules follow https://github.com/gabrielecirulli/2048 (MIT) — see lib/game.8bs.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { input } from "@8bitscript/input";
import { raster } from "@8bitscript/raster";
import { rng } from "./lib/rng.8bs";
import { Memory } from "@8bitscript/system";
import { computeLayout } from "./lib/tile.8bs";
import { wobble } from "./lib/wobble.8bs";
import { shown, merged, stepped, moved, over, started, moveLines, stepLines, spawnTile, hasMoves, resetGame } from "./lib/game.8bs";
import { App, Board, Tiles } from "./ui/App.8bx";
import { TitleScreen } from "./ui/TitleScreen.8bx";

// Whether this machine can change the picture part-way down a frame — the
// guard on the title screen's raster effect. A compile-time fact: the
// branch below folds, so a machine that answers false carries neither the
// disable() call nor a reference to the raster list.
const HAS_RASTER: bool = #fact(video.raster);

// Whether this build's grid can change shape under a running program —
// true only for the web's Modern host. A build-time constant, so
// `if (HAS_RESIZE)` folds the whole branch away on the eight machines
// whose grid cannot, the same way HAS_RASTER above does for the wobble:
// screen.resized() itself is a real runtime call (it tracks state, not a
// fact), so calling it unconditionally would link it — and the redraw it
// guards — into every target instead of just this one (measured: +57
// bytes on the 4K PET before this guard was added).
const HAS_RESIZE: bool = screen.RESIZABLE;

// Builds with this much RAM to spare animate a move: tiles slide one board
// cell per repaint instead of teleporting. Memory.RAM is a build-time fact
// and the branch on it folds, so the builds below the line — the 4K PET
// (3071 bytes), the unexpanded VIC-20 (3583), the NES (1536 of work RAM) —
// carry not one byte of the animation, and keep their instant moves.
const ANIM_MIN_RAM: usmallint = 4096;

// How long each step of the slide lingers: frames waited after each
// repaint. 1 makes a full-width slide land in 3 frames (a merge on the way
// adds a step or two) — 50–100ms at 60/50Hz, upstream 2048's own tempo.
// Raise it to slow the slide down; the board still settles to exactly the
// same position, so this is the one knob and it is safe to turn.
const ANIM_STEP_FRAMES: utinyint = 1;

// ---- the animated move --------------------------------------------------
//
// game.8bs's stepLines() takes the move one cell at a time; this repaints
// the board after each step that moved something and lingers
// ANIM_STEP_FRAMES, until a step moves nothing. Only the tiles are
// repainted between steps — the score a merge just banked appears with
// the settled board instead, and the header is not repainted five times
// in 100ms.
function animateMove(start: utinyint, step: utinyint, stride: utinyint): void {
    for (let i: utinyint = 0; i < 16; i++) {
        merged[i] = 0;
    }
    stepped = true;
    while (stepped) {
        stepped = false;
        stepLines(start, step, stride);
        if (stepped) {
            moved = true;
            Tiles();
            for (let f: utinyint = 0; f < ANIM_STEP_FRAMES; f++) {
                waitFrame();
                // Every waitFrame() needs a poll() right behind it (see
                // @8bitscript/pet/input.8bs and index.8bs's pia1PortB note):
                // reading the keyboard matrix is what clears the PET's
                // vertical-retrace flag, so skipping it here — as the first
                // cut of this animation did — leaves that flag stuck set.
                // The next waitFrame() then returns instantly instead of
                // pacing, and keys pressed mid-slide are never sampled, so
                // they either vanish or all land on the same edge check once
                // polling resumes — the "input does nothing, then five moves
                // fire at once" bug. Ignoring the result here (a move in
                // progress cannot be interrupted) still keeps the matrix and
                // the frame clock in sync for the next real move.
                input.poll();
            }
        }
    }
    return;
}

export function main(): void {
    // First, before anything else touches the hardware: on the C64 this
    // claims SID voice 3 and writes $D418 whole, and it has no way to know
    // if something else got there first. Empty on the seven targets with no
    // entropy source, and on the Atari, whose counter is already running.
    rng.begin();
    screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
    computeLayout();
    if (HAS_RESIZE) {
        // Establishes the grid computeLayout() just laid out for as the
        // baseline screen.resized() compares against, so the loop's own
        // check below only fires on a real later change — not on the
        // guaranteed-true first call resized() always makes (see
        // @8bitscript/web's screen.8bs).
        screen.resized();
    }
    input.begin();
    // One frame before the title is drawn, because on the web the host has
    // not finished introducing itself yet. The page writes its status byte —
    // the bit that says "this is a touchscreen" — when the worker hands it
    // the program's memory, which is the same moment the program starts
    // running. Drawing the title first is a race the program loses about as
    // often as it wins, and losing it puts PRESS ENTER on a phone.
    // waitFrame() is the program's own way of letting the host get a word in,
    // and every other target treats it as one idle frame at start-up.
    waitFrame();
    input.poll();
    TitleScreen();

    while (true) {
        waitFrame();
        input.poll();
        rng.tick(); // keep the generator moving between moves — see spawnTile()

        // The window resized or the phone rotated: every position lib/tile.8bs
        // (or a twin) computed depends on the grid computeLayout() read, so
        // it has to run again before anything else this frame draws. The
        // grid changed shape under whatever was already on screen, so a
        // reblank plus forcing every cell to redraw (shown[] holds no valid
        // exponent) is the same recovery resetGame() gives a fresh board —
        // without touching score, over, or won, which a resize does not
        // change — and App() puts back whichever of the title and the
        // board was up. Guarded by HAS_RESIZE, not just screen.resized()'s
        // own answer: resized() cannot fold, so without the guard this
        // whole block — and the otherwise-unreferenced resized() itself —
        // would link into all nine targets instead of just the one whose
        // grid can actually change.
        if (HAS_RESIZE) {
            if (screen.resized()) {
                computeLayout();
                screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
                for (let i: utinyint = 0; i < 16; i++) {
                    shown[i] = 255;
                }
                App();
            }
        }

        if (!started) {
            // One step of the title's raster wobble — an empty call,
            // deleted by the compiler, everywhere #fact(video.raster) is
            // false (see lib/wobble.8bs).
            wobble.step();
            if (input.confirm()) {
                started = true;
                if (HAS_RASTER) {
                    // The splits are the title screen's; nothing of them
                    // survives into the board. Before the blank and the
                    // first draw, so no frame shows the game through the
                    // title's colour band.
                    raster.disable();
                }
                screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
                resetGame();
                Board();
            }
            continue;
        }

        if (over) {
            if (input.confirm()) {
                // Clear the screen first, the same way starting the first
                // game does. The game-over message every skin draws sits in
                // the board's own gap rows, and a gap row is the one thing
                // <Tile /> never paints over — so without this the message
                // would survive into the next game. One blank here costs
                // every target less than an erase in every skin, and it is
                // what lets the narrowest of them carry the message at all.
                screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
                resetGame();
                Board();
            }
        } else {
            moved = false;
            // Two copies of the dispatch, one per mover, rather than one
            // dispatch into a move(start, step, stride) wrapper that
            // branches on Memory.RAM inside: the fold keeps whichever
            // copy this build gets and deletes the other, where a
            // parameterised wrapper survives folding as a real function
            // — 20 bytes measured back onto the 4K PET image.
            if (Memory.RAM < ANIM_MIN_RAM) {
                if (input.left()) {
                    moveLines(0, 1, 4);
                } else if (input.right()) {
                    moveLines(3, 255, 4);
                } else if (input.up()) {
                    moveLines(0, 4, 1);
                } else if (input.down()) {
                    moveLines(12, 252, 1);
                }
            } else {
                if (input.left()) {
                    animateMove(0, 1, 4);
                } else if (input.right()) {
                    animateMove(3, 255, 4);
                } else if (input.up()) {
                    animateMove(0, 4, 1);
                } else if (input.down()) {
                    animateMove(12, 252, 1);
                }
            }

            if (moved) {
                spawnTile();
                if (!hasMoves()) {
                    over = true;
                }
                Board();
            }
        }
    }
}
