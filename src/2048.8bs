// 2048 — for every 8BitScript target: VIC-20, C64, PET, C128, Atari 8-bit,
// NES, Commander X16, MEGA65, and the web. This is the program: it starts
// the session and runs a frame until the machine is turned off. What a
// frame does is lib/session.8bs's, a turn is lib/game/play.8bs's, the
// rules and the board are lib/game/rules.8bs's, what goes on the screen
// is ui/'s — Game.8bx is the root — and where each machine puts it is
// lib/layout/'s.
// Rules follow https://github.com/gabrielecirulli/2048 (MIT) — see lib/game/rules.8bs.
import { begin, frame } from "@lib/session.8bs";

export function main(): void {
    begin();
    while (true) {
        frame();
    }
}
