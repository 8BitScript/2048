// The web's default (Modern, 16:9 high-fi) tile: 8×5 reverse-video squares
// with 2×3-cell block-digits, a HUD down the side margins, and a game-over
// message laid into the board's gap rows. Picked up automatically for
// untagged web builds —
// nothing in main.8bs names this file; see docs/packages.md's
// "System-specific files". Machine skins are tile.web.<tag>.8bs, and those
// stay faithful to their machine: only this file is free to be laid out for
// a browser.
//
// ---- why the HUD is in the margins ---------------------------------------
//
// Rows are the scarce thing on this screen and columns are not: 48×27, and a
// board of four tiles plus three 1-row gaps is 4×TILE_H + 3 of those 27 rows.
// A HUD row across the top caps TILE_H at 5 — 23 rows of board, and four rows
// left over doing nothing. On a phone in landscape that showed up as exactly
// what it was: a strip of empty screen under the board, because the status
// line is suppressed on a touch host and the version only appears on the
// title screen.
//
// Putting the HUD in the side margins instead spends columns, which there are
// enough of, and gives every row to the board: 4×6 + 3 is 27 exactly.
//
// The tile is 8 wide, not 9, for two reasons. A digit is two cells wide, so a
// run of them is always an even number of cells: on an odd tile it can only
// ever sit half a cell off centre, and on an even one it is exact for one,
// two, three and four digits alike. And 8 leaves 13 columns of margin instead
// of 9, which is what buys the HUD a clear column between it and the board
// rather than butting straight against it.
import { screen, BorderColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";

// Keep in sync with package.json "version".
const VERSION_LINE: string = "v0.2.0";

const ROW: usmallint = text.COLUMNS; // 48

const TILE_W: utinyint = 8;
// Five rows, not six. A digit is three rows tall, and three inside six leaves
// three rows to share — one above and two below, so the number rides half a
// row high of centre. Three inside FIVE is one and one: exact. The board is
// then 23 of the 27 rows, and the four left over become a two-row margin above
// and below it, which matches the clear column the HUD already keeps on each
// side. Padding on every edge rather than four rows of nothing at the bottom.
const TILE_H: utinyint = 5;
const BLANK: string = "        "; // TILE_W spaces

const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];

// The block-digit font.
//
// Each digit is 3 half-cells of ink on a 4 half-cell pitch, so a run of them
// is always an ODD number of half-cells inside an EVEN tile. Centring it
// wants a half-cell offset and the character grid only places whole cells, so
// the ink can land 2px either side of the tile's centre and nowhere between.
// The gap rides behind the digits, which puts the ink on the left of those
// two — the side with the smaller leftover margin. Moving the gap in front of
// them (add 1 to the left column of every pair) puts it on the right instead.
// True centre needs a digit whose ink is an EVEN number of half-cells wide:
// a redesigned font, not a repositioning.
const DIGIT_TILES: array<utinyint, 60> = [
    142, 138, 138, 138, 139, 138,
    135, 128, 141, 128, 135, 130,
    140, 138, 131, 138, 139, 130,
    140, 138, 131, 138, 131, 138,
    138, 138, 139, 138, 128, 138,
    142, 136, 139, 130, 131, 138,
    142, 136, 139, 130, 139, 138,
    140, 138, 128, 138, 128, 138,
    142, 138, 139, 138, 139, 138,
    142, 138, 139, 138, 131, 138,
];// 4×4 of 8×5 tiles with 1-cell gaps: 35×23 on 48×27, at left 6, top 2 — two
// rows of margin above and below. Columns 0-5 and 41-47 are the margins the
// HUD lives in, and each keeps a clear column against the board.
const ORIGIN: array<usmallint, 16> = [
     102, 111, 120, 129,
     390, 399, 408, 417,
     678, 687, 696, 705,
     966, 975, 984, 993,
];

// One clear column on each side of everything: the left margin is columns
// 0-5 and the title sits in 1-4, so there is a blank column against the
// screen edge and another against the board. The right margin is 41-47 and
// the score sits in 42-46, the same way. The two margins differ by a column
// because "2048" is four characters and "SCORE" is five — the padding around
// them is what is even, which is what you actually see.
const TITLE_NAME_AT: usmallint = 97;      // row 2, col 1 — level with the board's top
const SCORE_LABEL_AT: usmallint = 138;    // row 2, col 42
const SCORE_VALUE_AT: usmallint = 186;    // row 3, col 42
const HINT_TOP_AT: usmallint = 1146;      // row 23, col 42 — two 5-column lines
const HINT_BOTTOM_AT: usmallint = 1194;   // row 24, col 42
const TITLE_AT: usmallint = 598;          // row 12, col 22 — "2048" on the title screen
const PROMPT_AT: usmallint = 690;         // row 14, col 18
const TOUCH_PROMPT_AT: usmallint = 689;  // "TOUCH TO START" is two
                                          // characters longer, so it
                                          // centres two columns left
const VERSION_AT: usmallint = 1286;       // row 26, col 38 — "v0.1.3"

// ---- the game-over message ------------------------------------------------
//
// Two lines laid into the board's own gap rows rather than a panel over it:
// "GAME OVER" in the blank row between the first and second rows of tiles,
// and how to play again in the row between the third and fourth. A panel
// covers the board at the one moment the board is most worth looking at —
// the position you lost on — and these two rows are the only ones on the
// screen that are already empty, so the message costs the board nothing.
// Rows 7 and 19 sit six rows either side of row 13, which is what makes the
// pair read as one message centred on the screen rather than two strings
// that happened to land in the gaps. Every other skin lays the same two
// lines into its own gap rows; only the numbers differ.
//
// Both lines are centred the way the title screen centres its own: start
// column is (48 - length) / 2. Both lines are white: red was tried for the
// title (2026-09-13, screenshot) and came out dimmer than the white prompt
// under it — the wrong way round for the line that matters more. The red
// the panel used to carry survives as the screen border.
const OVER_AT: usmallint = 355;          // row 7, col 19 — "GAME OVER"
const OVER_TOUCH_AT: usmallint = 927;    // row 19, col 15 — "TOUCH TO TRY AGAIN"
const OVER_KEY_AT: usmallint = 924;      // row 19, col 12 — "PRESS ENTER TO TRY AGAIN"

const HINT_BLANK: string = "     ";   // one margin line

// Nothing here erases the message. Both lines sit in the 1-row gaps between
// tiles — the rows drawTile() never touches — so the panel's trick of
// letting the tiles paint back over it would not have worked; main.8bs
// blanks the screen when the next game starts instead, which is the only
// way out of a finished game and clears every skin's message at once.

// The border main.8bs blanks to at start-up. Named here rather than written
// twice, so restoring it after a game over cannot drift from setting it.
const PLAYING_BORDER: utinyint = BorderColor.BLUE;

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.
const CREDIT_PORT_AT: usmallint = 1214;
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

export function computeLayout(): void {
}

export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_AT, "2048");
    if (input.touch()) {
        text.print(TOUCH_PROMPT_AT, "TOUCH TO START");
    } else {
        text.print(PROMPT_AT, "PRESS ENTER");
    }
    text.print(CREDIT_PORT_AT, " C  2026 8BITSCRIPT");
    text.putChar(CREDIT_PORT_AT, PAREN_OPEN);
    text.putChar(CREDIT_PORT_AT + 2, PAREN_CLOSE);
    text.print(VERSION_AT, VERSION_LINE);
    return;
}

function fillRows(origin: usmallint, rows: utinyint, blank: string): void {
    let rowCell: usmallint = origin;
    let row: utinyint = 0;
    while (row < rows) {
        text.print(rowCell, blank);
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

function drawOver(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(OVER_AT, "GAME OVER");
    if (input.touch()) {
        text.print(OVER_TOUCH_AT, "TOUCH TO TRY AGAIN");
    } else {
        text.print(OVER_KEY_AT, "PRESS ENTER TO TRY AGAIN");
    }
    return;
}

export function drawHud(score: usmallint, over: bool, won: bool): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_NAME_AT, "2048");
    text.print(SCORE_LABEL_AT, "SCORE");
    text.print(SCORE_VALUE_AT, `${score:5}`);
    // Always write both hint lines, never just leave them: the branch that
    // printed nothing is what used to strand "YOU MADE 2048" on screen across
    // a restart, and would now strand the arrow-key hint through a game over.
    if (won) {
        text.print(HINT_TOP_AT, "YOU  ");
        text.print(HINT_BOTTOM_AT, "WIN! ");
    } else if (!over && !input.touch()) {
        text.print(HINT_TOP_AT, "ARROW");
        text.print(HINT_BOTTOM_AT, "KEYS ");
    } else {
        text.print(HINT_TOP_AT, HINT_BLANK);
        text.print(HINT_BOTTOM_AT, HINT_BLANK);
    }
    // Two lines inside the board are a quiet thing to say; the border turning
    // red is the rest of the screen saying it too, which is why the host
    // always draws a border, however thin. drawHud() runs once per move, and
    // exactly once with over set, so neither arm needs a flag to not repeat.
    if (over) {
        screen.setBorder(BorderColor.RED);
        drawOver();
    } else {
        screen.setBorder(PLAYING_BORDER);
    }
    return;
}

function fillTile(origin: usmallint, exponent: utinyint): void {
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    fillRows(origin, TILE_H, BLANK);
    return;
}

function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        text.putChar(rowCell, DIGIT_TILES[base]);
        text.putChar(rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let origin: usmallint = ORIGIN[row * 4 + col];
    fillTile(origin, exponent);
    let base: utinyint = TILE_DIGIT_AT[exponent];
    let count: utinyint = TILE_DIGIT_AT[exponent + 1] - base;
    if (count != 0) {
        // Digits are 2 cells wide and 3 rows tall. Across TILE_W that is
        // exact for every digit count, because both are even. Down TILE_H it
        // cannot be: three rows in six leaves three to share, so the run sits
        // one row from the top and two from the bottom — half a row high of
        // true centre, and the nearest a 3-row glyph gets in a 6-row tile.
        let at: usmallint = origin + ROW + ((TILE_W >> 1) - count);
        let i: utinyint = 0;
        while (i < count) {
            drawDigit(at, TILE_DIGIT[base + i]);
            at = at + 2;
            i++;
        }
    }
    text.setReverse(false);
    return;
}

// The title wobble is tile.8bs's — the portable skin, read by the one
// 6502 machine with a per-scanline hook (the C64). The web answers
// #fact(video.raster) true too, but this skin draws its own title and
// does not take the effect up yet; an empty function here means the
// compiler deletes the call, and the game's raster.disable() at start is
// a no-op against a list that was never built.
export function wobbleTitle(): void {
    return;
}
