// The web's default (Modern, 16:9 high-fi) tile: 9×6 reverse-video squares
// with 2×3-cell block-digits, a HUD down the side margins, and a centred
// game-over panel. Picked up automatically for untagged web builds —
// nothing in main.8bs names this file; see docs/packages.md's
// "System-specific files". Machine skins are tile.web.<tag>.8bs, and those
// stay faithful to their machine: only this file is free to be laid out for
// a browser.
//
// ---- why the HUD is in the margins ---------------------------------------
//
// Rows are the scarce thing on this screen and columns are not: 48×27, and a
// board of four tiles plus three 1-row gaps is 4×TILE_H + 3 of those 27 rows.
// A HUD row across the top caps TILE_H at 5 — 23 rows of board, and four rows
// left over doing nothing. On a phone in landscape that showed up as exactly
// what it was: a strip of empty screen under the board, because the status
// line is suppressed on a touch host and the version only appears on the
// title screen.
//
// Putting the HUD in the side margins instead spends columns, which there are
// enough of, and gives every row to the board: 4×6 + 3 is 27 exactly. The
// tile goes from 10×5 to 9×6 — 72×48 pixels instead of 80×40, 8% more area
// and much nearer square, which is what a 2048 tile should look like. The
// margins left over are 4 columns for the title and 5 for the score, which
// is what each needs to the character.
import { screen, BorderColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";

// Keep in sync with package.json "version".
const VERSION_LINE: string = "v0.1.3";

const ROW: usmallint = text.COLUMNS; // 48

const TILE_W: utinyint = 9;
const TILE_H: utinyint = 6;
const BLANK: string = "         "; // TILE_W spaces

const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];

const DIGIT_TILES: array<utinyint, 60> = [
    142, 138, 138, 138, 139, 138,
    135, 128, 141, 128, 135, 130,
    140, 138, 131, 138, 139, 130,
    140, 138, 131, 138, 131, 138,
    138, 138, 139, 138, 128, 138,
    142, 136, 139, 130, 131, 138,
    142, 136, 139, 130, 139, 138,
    140, 138, 128, 138, 128, 138,
    142, 138, 139, 138, 139, 138,
    142, 138, 139, 138, 131, 138,
];

// 4×4 of 9×6 tiles with 1-cell gaps: 39×27 on 48×27, at left 4, top 0 — the
// full height of the screen. Columns 0-3 and 43-47 are the margins the HUD
// lives in.
const ORIGIN: array<usmallint, 16> = [
       4,   14,   24,   34,
     340,  350,  360,  370,
     676,  686,  696,  706,
    1012, 1022, 1032, 1042,
];

const TITLE_NAME_AT: usmallint = 48;      // row 1, col 0 — "2048" fills the left margin
const SCORE_LABEL_AT: usmallint = 91;     // row 1, col 43 — "SCORE" fills the right one
const SCORE_VALUE_AT: usmallint = 139;    // row 2, col 43
const HINT_TOP_AT: usmallint = 1195;      // row 24, col 43 — two 5-column lines
const HINT_BOTTOM_AT: usmallint = 1243;   // row 25, col 43
const TITLE_AT: usmallint = 598;          // row 12, col 22 — "2048" on the title screen
const PROMPT_AT: usmallint = 690;         // row 14, col 18
const VERSION_AT: usmallint = 1286;       // row 26, col 38 — "v0.1.3"

// ---- the game-over panel --------------------------------------------------
//
// A 28×9 panel centred on the board (cols 10-37, rows 9-17) rather than a
// line of text at the bottom: game over is the one moment the game interrupts
// the player, and it should read as something that happened, not as a HUD
// field that changed. The screen border goes red underneath it, which is why
// the host now always draws a border, however thin.
const PANEL_W: utinyint = 28;
const PANEL_H: utinyint = 9;
const PANEL_BLANK: string = "                            "; // PANEL_W spaces
const PANEL_AT: usmallint = 442;          // row 9, col 10 — the red frame
const PANEL_BODY_W: utinyint = 26;
const PANEL_BODY_H: utinyint = 5;
const PANEL_BODY_BLANK: string = "                          "; // PANEL_BODY_W spaces
const PANEL_BODY_AT: usmallint = 587;     // row 12, col 11 — the white card inside it
const PANEL_TITLE_AT: usmallint = 499;    // row 10, col 19 — "GAME OVER", in the band
const PANEL_SCORE_AT: usmallint = 642;    // row 13, col 18 — "SCORE 12345"
const PANEL_TAP_AT: usmallint = 736;      // row 15, col 16 — "TAP TO CONTINUE"
const PANEL_KEY_AT: usmallint = 738;      // row 15, col 18 — "PRESS ENTER"
const HINT_BLANK: string = "     ";   // one margin line

// The panel is drawn once when the game ends and erased once when the next
// game starts, rather than restamped on every HUD paint: main.8bs's
// resetGame() forces all sixteen tiles to redraw, so erasing the panel here
// and letting the tiles paint back over it is all the restore that is needed.
let panelShown: bool = false;

// The border main.8bs blanks to at start-up. Named here rather than written
// twice, so restoring it after a game over cannot drift from setting it.
const PLAYING_BORDER: utinyint = BorderColor.BLUE;

export function computeLayout(): void {
}

export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_AT, "2048");
    if (input.touch()) {
        text.print(PROMPT_AT, "TAP TO START");
    } else {
        text.print(PROMPT_AT, "PRESS ENTER");
    }
    text.print(VERSION_AT, VERSION_LINE);
    return;
}

function fillRows(origin: usmallint, rows: utinyint, blank: string): void {
    let rowCell: usmallint = origin;
    let row: utinyint = 0;
    while (row < rows) {
        text.print(rowCell, blank);
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

function drawPanel(score: usmallint): void {
    // A red frame with a white card inside it. The card cannot simply be
    // white on its own: an empty board cell is also a white block, so a white
    // panel laid over the board has no edge you can see. The red surround is
    // what makes it read as something in front of the board rather than part
    // of it — and it is the same red the screen border turns.
    //
    // A reverse cell fills with the foreground and punches the glyph out in
    // the screen background, so every line of text on the panel is black.
    text.setReverse(true);
    text.setColor(TextColor.RED);
    fillRows(PANEL_AT, PANEL_H, PANEL_BLANK);
    text.print(PANEL_TITLE_AT, "GAME OVER");
    text.setColor(TextColor.WHITE);
    fillRows(PANEL_BODY_AT, PANEL_BODY_H, PANEL_BODY_BLANK);
    text.print(PANEL_SCORE_AT, `SCORE ${score:5}`);
    if (input.touch()) {
        text.print(PANEL_TAP_AT, "TAP TO CONTINUE");
    } else {
        text.print(PANEL_KEY_AT, "PRESS ENTER");
    }
    text.setReverse(false);
    return;
}

function erasePanel(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    fillRows(PANEL_AT, PANEL_H, PANEL_BLANK);
    return;
}

export function drawHud(score: usmallint, over: bool, won: bool): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_NAME_AT, "2048");
    text.print(SCORE_LABEL_AT, "SCORE");
    text.print(SCORE_VALUE_AT, `${score:5}`);
    // Always write both hint lines, never just leave them: the branch that
    // printed nothing is what used to strand "YOU MADE 2048" on screen across
    // a restart, and would now strand the arrow-key hint under the panel.
    if (won) {
        text.print(HINT_TOP_AT, "YOU  ");
        text.print(HINT_BOTTOM_AT, "WIN! ");
    } else if (!over && !input.touch()) {
        text.print(HINT_TOP_AT, "ARROW");
        text.print(HINT_BOTTOM_AT, "KEYS ");
    } else {
        text.print(HINT_TOP_AT, HINT_BLANK);
        text.print(HINT_BOTTOM_AT, HINT_BLANK);
    }
    if (over) {
        if (!panelShown) {
            // The border is the one part of the screen still visible past the
            // panel, and a red edge is the whole screen saying so.
            screen.setBorder(BorderColor.RED);
            drawPanel(score);
            panelShown = true;
        }
    } else if (panelShown) {
        screen.setBorder(PLAYING_BORDER);
        erasePanel();
        panelShown = false;
    }
    return;
}

function fillTile(origin: usmallint, exponent: utinyint): void {
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    fillRows(origin, TILE_H, BLANK);
    return;
}

function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        text.putChar(rowCell, DIGIT_TILES[base]);
        text.putChar(rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let origin: usmallint = ORIGIN[row * 4 + col];
    fillTile(origin, exponent);
    let base: utinyint = TILE_DIGIT_AT[exponent];
    let count: utinyint = TILE_DIGIT_AT[exponent + 1] - base;
    if (count != 0) {
        // Digits are 2 cells wide and 3 rows tall: centre them across
        // TILE_W and down TILE_H.
        let at: usmallint = origin + ROW + ((TILE_W >> 1) - count);
        let i: utinyint = 0;
        while (i < count) {
            drawDigit(at, TILE_DIGIT[base + i]);
            at = at + 2;
            i++;
        }
    }
    text.setReverse(false);
    return;
}
