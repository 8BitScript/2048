// Web VIC-20 skin: 22×23, 4-wide tiles with a one-cell gap — the same
// board tile.8bs draws on a real VIC-20. Picked up when the web build's
// hardware tag is `vic20`.
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";

const VERSION_LINE: string = "v0.2.0";

const ROW: usmallint = text.COLUMNS; // 22
const TILE_W: utinyint = 4;
const TILE_H: utinyint = 3;
const BLANK: string = "    ";

const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

// boardTop 4, left 1, 4×3 tiles, 1-cell gaps (stride 5×4)
const ORIGIN: array<usmallint, 16> = [
    89, 94, 99, 104,
    177, 182, 187, 192,
    265, 270, 275, 280,
    353, 358, 363, 368,
];

const HEADER_AT: usmallint = 45;
const SCORE_HEADER_LEN: utinyint = 11;
const STATUS_AT: usmallint = 441;
const TITLE_AT: usmallint = 229;
const PROMPT_AT: usmallint = 269;
const TOUCH_PROMPT_AT: usmallint = 268;  // "TOUCH TO START" is two
                                          // characters longer, so it
                                          // centres two columns left
const VERSION_AT: usmallint = 500;

// ---- the game-over message ------------------------------------------------
//
// "GAME OVER" in the blank row between the first and second rows of tiles
// (row 7), how to play again in the row between the third and fourth (row
// 15), instead of one line under the board — the same two lines every other
// skin draws, at this skin's own numbers. Both rows are already empty (a
// gap row is the one thing drawTile() never touches), so the message costs
// the board nothing and leaves the position that ended the game in view.
// Each line is centred on the screen: (22 - length) / 2, which is what
// decides the wording. PRESS ENTER TO TRY AGAIN, which the 40- and
// 48-column skins say, is 24 characters and would not fit on the screen at
// all — and at 20 characters even PRESS ENTER TO RETRY ran the full width
// of the row, reading as a bar across the board rather than a line inside
// it (2026-09-13, screenshot). So this skin drops the PRESS, and both
// prompts are 18 characters at the same column.
const OVER_AT: usmallint = 160;         // row 7, col 6 — "GAME OVER"
const OVER_PROMPT_AT: usmallint = 332;  // row 15, col 2 — both prompts are 18
// One blank as wide as the longest line, from the column that line starts
// in: it covers either gap row, and the 19-column status line as well.
// The status line is the only thing this skin erases: the game-over
// lines are cleared by main.8bs blanking the screen for the next game.
const STATUS_BLANK: string = "                   "; // 19 spaces

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.
const CREDIT_PORT_AT: usmallint = 463;
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

export function computeLayout(): void {
}

export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_AT, "2048");
    if (input.touch()) {
        text.print(TOUCH_PROMPT_AT, "TOUCH TO START");
    } else {
        text.print(PROMPT_AT, "PRESS ENTER");
    }
    text.print(CREDIT_PORT_AT, " C  2026 8BITSCRIPT");
    text.putChar(CREDIT_PORT_AT, PAREN_OPEN);
    text.putChar(CREDIT_PORT_AT + 2, PAREN_CLOSE);
    text.print(VERSION_AT, VERSION_LINE);
    return;
}

export function drawHud(score: usmallint, over: bool, won: bool): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(HEADER_AT, "2048");
    text.print(text.COLUMNS - SCORE_HEADER_LEN, `SCORE ${score:5}`);
    // Always write the status line, never just leave it: the branch that
    // printed nothing is what used to strand a message across a restart on
    // a touch host, where ARROWS TO MOVE is suppressed.
    if (won) {
        text.print(STATUS_AT, "YOU MADE 2048      ");
    } else if (!over && !input.touch()) {
        text.print(STATUS_AT, "ARROWS TO MOVE     ");
    } else {
        text.print(STATUS_AT, STATUS_BLANK);
    }
    // Nothing erases these two lines: main.8bs blanks the screen when the
    // next game starts, which is the only way out of a finished game.
    if (over) {
        text.print(OVER_AT, "GAME OVER");
        if (input.touch()) {
            text.print(OVER_PROMPT_AT, "TOUCH TO TRY AGAIN");
        } else {
            text.print(OVER_PROMPT_AT, "ENTER TO TRY AGAIN");
        }
    }
    return;
}

function tileWidth(value: usmallint): utinyint {
    if (value >= 1000) {
        return 4;
    }
    if (value >= 100) {
        return 3;
    }
    if (value >= 10) {
        return 2;
    }
    return 1;
}

export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let origin: usmallint = ORIGIN[row * 4 + col];
    let value: usmallint = POW2[exponent];
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    let line: utinyint = 0;
    while (line < TILE_H) {
        text.print(origin + line * ROW, BLANK);
        line++;
    }
    if (value != 0) {
        let width: utinyint = tileWidth(value);
        let offset: utinyint = (TILE_W - width) >> 1;
        text.printNumber(origin + (TILE_H >> 1) * ROW + offset, value, width);
    }
    text.setReverse(false);
    return;
}
