// Where the game's random numbers come from, in one place. The portable
// default is @8bitscript/random's deterministic generator; the C64 and
// Atari 8-bit read hardware entropy when `#system()` says that is the
// build — dead branches fold away on the other seven targets.
import { random } from "@8bitscript/random";
import { random as c64Random } from "@8bitscript/c64/random";
import { random as atariRandom } from "@8bitscript/atari8/random";
import { System } from "@8bitscript/system";

export namespace rng {
    function begin(): void {
        if (#system() == System.C64) {
            c64Random.begin();
        }
    }

    function tick(): void {
        if (#system() == System.C64 || #system() == System.ATARI8) {
        } else {
            random.next();
        }
    }

    function range(bound: utinyint): utinyint {
        if (#system() == System.C64) {
            return c64Random.byte() % bound;
        }
        if (#system() == System.ATARI8) {
            return atariRandom.byte() % bound;
        }
        return random.next() % bound;
    }
}
