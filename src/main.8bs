// 2048 — one source file, every 8BitScript target: VIC-20, C64, PET, C128,
// Atari 8-bit, NES, Commander X16, MEGA65, and the web. Rules follow
// https://github.com/gabrielecirulli/2048 (MIT): a 4x4 grid, arrows slide
// every tile as far as it goes, two equal tiles that collide combine into
// one worth their sum, and a new 2 (usually) or 4 (one time in ten) appears
// after every move that actually changed the board.
//
// The board holds exponents, not face values: 0 is empty, and N is the tile
// worth 2^N (1 = 2, 2 = 4, ... 11 = 2048). A `utinyint` holds that in one
// byte where the real value would need two, and "two equal tiles merge"
// becomes "two equal exponents merge into exponent + 1" — one add instead
// of a double and a compare.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { input } from "@8bitscript/input";
import { random } from "@8bitscript/random";
import { Memory } from "@8bitscript/system";
import { computeLayout, drawHud, drawTile } from "./tile.8bs";

const SIZE: utinyint = 4; // 4x4 — 2048's own board, on every target
const MAX_EXPONENT: utinyint = 11; // 2^11 = 2048, the tile that wins

// Builds with this much RAM to spare animate a move: tiles slide one board
// cell per repaint instead of teleporting. Memory.RAM is a build-time fact
// and the branch on it folds, so the builds below the line — the 4K PET
// (3071 bytes), the unexpanded VIC-20 (3583), the NES (1536 of work RAM) —
// carry not one byte of the animation, and keep their instant moves.
const ANIM_MIN_RAM: usmallint = 4096;

// How long each step of the slide lingers: frames waited after each
// repaint. 1 makes a full-width slide land in 3 frames (a merge on the way
// adds a step or two) — 50–100ms at 60/50Hz, upstream 2048's own tempo.
// Raise it to slow the slide down; the board still settles to exactly the
// same position, so this is the one knob and it is safe to turn.
const ANIM_STEP_FRAMES: utinyint = 1;

// Exponent to face value — the only place 2^N is written down in the
// rules (tile.8bs has its own copy for drawing; the PET twin never
// needs it, and linking it there would spend 24 bytes of the 4K
// image on a table mergeLine() already has).
const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

// The board, and the one scratch row/column a move is worked out in. Both
// are RAM, not data: a move rewrites them, so neither can be a `const`.
// `shown` is what is actually on screen, so a stationary tile is never
// erased and redrawn — fill-then-stamp on a tile that did not move is
// the blink.
let board: array<utinyint, 16>;
let shown: array<utinyint, 16>;
let line: array<utinyint, 4>;

// Animated builds only (both fold away below ANIM_MIN_RAM): merged[i]
// rides along with the tile in cell i for the length of one move, so a
// tile that has already combined once cannot combine again while it is
// still sliding — the rule mergeLine() gets for free from its single
// left-to-right pass. stepped is "did the last step move anything":
// false ends the move.
let merged: array<utinyint, 16>;
let stepped: bool = false;

let score: usmallint = 0;
let moved: bool = false; // did the move just played actually change the board?
let over: bool = false; // no move left that would change the board
let won: bool = false; // a 2048 has appeared; play continues past it, as upstream does

// ---- moving a line -----------------------------------------------------
//
// Every direction is the same three-step slide over a 4-cell line — compress
// (push non-zero values together, preserving order), merge (equal
// neighbours combine once, left to right), compress again (a merge leaves a
// zero where the second tile was). The four directions only differ in the
// start cell, the step along the line, and the stride to the next line —
// `moveLines` walks them with wrapping utinyint add (255 is −1, 252 is −4).
//
// Helpers that would otherwise be inlined (a no-parameter void with no
// `return`) end with `return` so the compiler keeps them as real calls:
// four directions × compress/merge used to paste the same body into main
// four times, and that was most of the 7K image.

function compressLine(): void {
    let write: utinyint = 0;
    for (let read: utinyint = 0; read < SIZE; read++) {
        if (line[read] != 0) {
            if (write != read) {
                line[write] = line[read];
                line[read] = 0;
                moved = true;
            }
            write++;
        }
    }
    return;
}

function mergeLine(): void {
    for (let i: utinyint = 0; i < SIZE - 1; i++) {
        if (line[i] != 0 && line[i] == line[i + 1]) {
            line[i] = line[i] + 1; // one higher exponent: double the value
            line[i + 1] = 0;
            score = score + POW2[line[i]];
            if (line[i] == MAX_EXPONENT) {
                won = true;
            }
            moved = true;
        }
    }
    return;
}

function slide(a: utinyint, b: utinyint, c: utinyint, d: utinyint): void {
    line[0] = board[a];
    line[1] = board[b];
    line[2] = board[c];
    line[3] = board[d];
    compressLine();
    mergeLine();
    compressLine();
    board[a] = line[0];
    board[b] = line[1];
    board[c] = line[2];
    board[d] = line[3];
    return;
}

function moveLines(start: utinyint, step: utinyint, stride: utinyint): void {
    for (let n: utinyint = 0; n < SIZE; n++) {
        let a: utinyint = start;
        let b: utinyint = a + step;
        let c: utinyint = b + step;
        let d: utinyint = c + step;
        slide(a, b, c, d);
        start = start + stride;
    }
    return;
}

// ---- the animated move --------------------------------------------------
//
// The same move as compress/merge/compress, taken one cell at a time so
// there is something to watch: each step, every tile that can advance one
// cell toward the wall does — into an empty neighbour, or onto an equal
// tile neither half of which has merged this move — the board is
// repainted, and the step lingers ANIM_STEP_FRAMES. When a step moves
// nothing the move is finished, and the board it settles on is exactly the
// board moveLines() would have written at once: iterating "shift or merge
// one cell" with the merged[] lock reaches the same fixed point (the lock
// is what stops 2 2 2 2 collapsing past 4 4, and a fresh 4 swallowing the
// 4 sliding up behind it).

function stepPair(a: utinyint, b: utinyint): void {
    // b is the cell one step behind a. One step of one tile: advance
    // b's tile into a, or merge it onto a's.
    if (board[b] == 0) {
        return;
    }
    if (board[a] == 0) {
        board[a] = board[b];
        merged[a] = merged[b];
        board[b] = 0;
        merged[b] = 0;
        stepped = true;
        return;
    }
    if (board[a] == board[b] && merged[a] == 0 && merged[b] == 0) {
        board[a] = board[a] + 1; // one higher exponent: double the value
        merged[a] = 1;
        board[b] = 0;
        score = score + POW2[board[a]];
        if (board[a] == MAX_EXPONENT) {
            won = true;
        }
        stepped = true;
    }
    return;
}

// Front pair first, so a whole line in motion advances together in one
// step — d follows c into the cell c just left — rather than one tile
// per step.
function stepLines(start: utinyint, step: utinyint, stride: utinyint): void {
    for (let n: utinyint = 0; n < SIZE; n++) {
        let a: utinyint = start;
        let b: utinyint = a + step;
        let c: utinyint = b + step;
        let d: utinyint = c + step;
        stepPair(a, b);
        stepPair(b, c);
        stepPair(c, d);
        start = start + stride;
    }
    return;
}

// The per-step repaint: drawBoard()'s tile loop without the HUD — the
// score a merge just banked appears with the settled board instead, and
// the header is not repainted five times in 100ms. Its own copy of the
// loop rather than a helper drawBoard() shares, so the builds that fold
// the animation away keep drawBoard() — and the 4K PET image — exactly
// as they were; here it costs a machine with RAM to spare ~30 bytes.
function drawSlidTiles(): void {
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] != shown[i]) {
            drawTile(i >> 2, i & 3, board[i]);
            shown[i] = board[i];
        }
    }
    return;
}

function animateMove(start: utinyint, step: utinyint, stride: utinyint): void {
    for (let i: utinyint = 0; i < 16; i++) {
        merged[i] = 0;
    }
    stepped = true;
    while (stepped) {
        stepped = false;
        stepLines(start, step, stride);
        if (stepped) {
            moved = true;
            drawSlidTiles();
            for (let f: utinyint = 0; f < ANIM_STEP_FRAMES; f++) {
                waitFrame();
                // Every waitFrame() needs a poll() right behind it (see
                // @8bitscript/pet/input.8bs and index.8bs's pia1PortB note):
                // reading the keyboard matrix is what clears the PET's
                // vertical-retrace flag, so skipping it here — as the first
                // cut of this animation did — leaves that flag stuck set.
                // The next waitFrame() then returns instantly instead of
                // pacing, and keys pressed mid-slide are never sampled, so
                // they either vanish or all land on the same edge check once
                // polling resumes — the "input does nothing, then five moves
                // fire at once" bug. Ignoring the result here (a move in
                // progress cannot be interrupted) still keeps the matrix and
                // the frame clock in sync for the next real move.
                input.poll();
            }
        }
    }
    return;
}

// ---- spawning, and knowing when to stop ---------------------------------

// One new tile in a random empty cell: a 2 nine times in ten, a 4 the
// tenth. random.range() is 8BitScript's own deterministic generator
// (@8bitscript/random) — explicitly seeded, never hardware entropy — ticked
// once a frame in main()'s loop below, so the sequence depends on how long
// the player actually took between moves rather than repeating the same
// game every run.
function spawnTile(): void {
    let empties: utinyint = 0;
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] == 0) {
            empties++;
        }
    }
    if (empties == 0) {
        return;
    }
    let target: utinyint = random.range(empties);
    let exponent: utinyint = 1;
    if (random.range(10) == 0) {
        exponent = 2;
    }
    let seenEmpty: utinyint = 0;
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] == 0) {
            if (seenEmpty == target) {
                board[i] = exponent;
                return;
            }
            seenEmpty++;
        }
    }
}

// No empty cell and no adjacent equal pair, in either direction, anywhere:
// nothing left that any of the four moves could change.
function hasMoves(): bool {
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] == 0) {
            return true;
        }
        if ((i & 3) != 3 && board[i] == board[i + 1]) {
            return true;
        }
        if (i < 12 && board[i] == board[i + 4]) {
            return true;
        }
    }
    return false;
}

// ---- drawing --------------------------------------------------------------
//
// drawTile() and drawHud() live in tile.8bs (tile.pet.8bs on the PET) —
// see that file's header for why one target needs its own. The PET twin
// writes screen codes directly so this file never links text.print.

// Only tiles whose exponent changed since last paint are stamped. Sixteen
// filled squares with a background-coloured gap between them already read
// as one board; redrawing a tile that did not move blanks it first and
// that is the blink.
function drawBoard(): void {
    drawHud(score, over, won);
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] != shown[i]) {
            drawTile(i >> 2, i & 3, board[i]);
            shown[i] = board[i];
        }
    }
    return;
}

function resetGame(): void {
    for (let i: utinyint = 0; i < 16; i++) {
        board[i] = 0;
        shown[i] = 255; // not an exponent: force every cell to stamp once
    }
    score = 0;
    over = false;
    won = false;
    spawnTile();
    spawnTile();
    return;
}

export function main(): void {
    screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
    computeLayout();
    input.begin();
    resetGame();
    drawBoard();

    while (true) {
        waitFrame();
        input.poll();
        random.next(); // keep the generator moving between moves — see spawnTile()

        if (over) {
            if (input.confirm()) {
                resetGame();
                drawBoard();
            }
        } else {
            moved = false;
            // Two copies of the dispatch, one per mover, rather than one
            // dispatch into a move(start, step, stride) wrapper that
            // branches on Memory.RAM inside: the fold keeps whichever
            // copy this build gets and deletes the other, where a
            // parameterised wrapper survives folding as a real function
            // — 20 bytes measured back onto the 4K PET image.
            if (Memory.RAM < ANIM_MIN_RAM) {
                if (input.left()) {
                    moveLines(0, 1, 4);
                } else if (input.right()) {
                    moveLines(3, 255, 4);
                } else if (input.up()) {
                    moveLines(0, 4, 1);
                } else if (input.down()) {
                    moveLines(12, 252, 1);
                }
            } else {
                if (input.left()) {
                    animateMove(0, 1, 4);
                } else if (input.right()) {
                    animateMove(3, 255, 4);
                } else if (input.up()) {
                    animateMove(0, 4, 1);
                } else if (input.down()) {
                    animateMove(12, 252, 1);
                }
            }

            if (moved) {
                spawnTile();
                if (!hasMoves()) {
                    over = true;
                }
                drawBoard();
            }
        }
    }
}
