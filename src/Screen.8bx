// What 2048 puts on the screen, as composition. The rules and the board
// are game.8bs's; how a tile, the HUD or the title is actually painted is
// tile.8bs's (and its per-machine twins'); this file is the arrangement —
// which of those goes on the screen, and when — and nothing else, so a
// reader can see the whole picture without a single screen address.
//
// It is the first .8bx in a real program, and the measure of it is that
// it costs nothing: a component is a function, an element is a call, and
// every one of the thirteen release builds is byte-identical to the
// version that wrote these calls out by hand in 2048.8bs (2026-09-16,
// against the 0.11.0 toolchain; the animated builds are a few bytes
// smaller, because <Tiles /> is one function where the hand-written
// program kept a second copy of the loop).
import { board, shown, score, over, won, started } from "./game.8bs";
import { drawHud, drawTile, drawTitleScreen } from "./tile.8bs";

// The title screen, up until confirm starts a game.
export component Title() {
    drawTitleScreen();
}

// The sixteen tiles — only the ones whose exponent changed since they were
// last stamped. Sixteen filled squares with a background-coloured gap
// between them already read as one board; redrawing a tile that did not
// move blanks it first and that is the blink. The animated move repaints
// with this alone, between steps; the settled board takes the HUD too.
export component Tiles() {
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] != shown[i]) {
            drawTile(i >> 2, i & 3, board[i]);
            shown[i] = board[i];
        }
    }
}

// The board as the player sees it: the HUD, then the tiles. The HUD comes
// first so the score a merge just banked appears with the board that
// earned it.
export component Board() {
    drawHud(score, over, won);
    <Tiles />;
}

// Whatever is on the screen right now — for putting it back after the
// grid changes shape under it (the web's fluid host, on a resize or a
// rotated phone).
export component Screen() {
    return (<>{started ? <Board /> : <Title />}</>);
}
