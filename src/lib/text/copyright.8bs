// The port's copyright line: where it is on this skin, that it is up only
// until the first move, and how it goes. In lib/ rather than in the
// element so a turn (lib/game/play.8bs) can take it down without
// importing an element, and so the element and the effect agree on the
// cell — ui/Copyright.8bx prints it where copyrightAt() says.
//
// The line is the program's greeting, not every game's: it is on screen
// from the first frame until the first move that changes the board, and
// then it goes the way a PET erases a line — a reverse-video cursor runs
// along it, one cell a frame, and leaves nothing behind. After that no
// Screen() prints it again (ui/Screen.8bx tests copyrightDismissed), a
// resize or a new game included, and the header is the name and the score.
//
// One cell a frame is nineteen frames, a third of a second at 60 Hz, which
// is long enough to read as a cursor. It runs alongside the game, not in
// front of it: a move during the sweep is taken, and the slide does not
// wait for the cursor (stepCopyright() is one frame of it).
import { text } from "@8bitscript/text";
import { screen } from "@8bitscript/screen";
import { input } from "@8bitscript/input";
import { System, Video } from "@8bitscript/system";
import { Game, Copyright as Copy } from "@8bitscript/i18n/catalog";
import { COPYRIGHT_ON_HEADER, board, boardLeft, headerAt } from "@lib/layout/layout.8bs";

const FLUID: bool = screen.RESIZABLE;
const ROW: usmallint = text.COLUMNS;
const SPACE: utinyint = 32;

// Set once, by dismissCopyright(), and never cleared. No initializer: a
// let's zero initialization is "still up", and an initializer would be a
// store in the image for a value the let already has.
export let copyrightDismissed: bool;

// How wide the line this build prints is: the NES spells COPYRIGHT out
// (its font draws "(" and ")" blank — see ui/Copyright.8bx), every other
// machine prints the short line. #system() folds, so one return survives.
export function copyrightWidth(): utinyint {
    if (#system() == System.NES) {
        return Copy.WORD.length;
    }
    return Copy.LINE.length;
}

// Whether there is room for it: always on a fixed grid, and on the fluid
// host when the window is at least two rows tall and as wide as the line.
export function copyrightFits(): bool {
    if (FLUID) {
        return text.rows() >= 2 && text.columns() >= Copy.LINE.length;
    }
    return true;
}

// The line's first cell. On the PET's header it follows the name
// (COPYRIGHT_ON_HEADER); on the VIC-20's one footer row it starts at the
// board's left edge and, at 19 cells, ends on its right one; on the fluid host it is centred on the
// second-to-last row of whatever grid the window has now; on every other
// fixed grid it is centred on the second-to-last row, which folds to one
// literal per build.
export function copyrightAt(): usmallint {
    if (COPYRIGHT_ON_HEADER) {
        return headerAt + boardLeft + Game.NAME.length + 1;
    }
    if (!FLUID && text.COLUMNS < board.FULL_WIDTH) {
        return (Video.ROWS - 1) * ROW + boardLeft;
    }
    if (FLUID) {
        let cols: usmallint = text.columns();
        let rows: usmallint = text.rows();
        return (rows - 2) * cols + ((cols - Copy.LINE.length) >> 1);
    }
    if (#system() == System.NES) {
        return (Video.ROWS - 2) * ROW + ((text.COLUMNS - Copy.WORD.length) >> 1);
    }
    return (Video.ROWS - 2) * ROW + ((text.COLUMNS - Copy.LINE.length) >> 1);
}

// Takes the line down, a frame at a time: a reverse-video block runs along
// it from the left, one cell a frame, blanking the cell it just left, and
// runs one cell off the end — into the blank every skin keeps after the
// line — so the sweep has no first or last case to test for.
// dismissCopyright() only starts it; stepCopyright() is one frame of it,
// called from the frame loop (2048.8bs) and from the slide's own frames
// (lib/game/play.8bs), so the player can keep moving while it runs. The
// flag is set first, so a Screen() during or after the sweep never puts
// the line back. Reverse video is switched off again after every cell,
// because the board is drawn between frames. One counting cell and one
// countdown rather than `at + i`: three 16-bit adds a frame were 60 bytes
// on the PET (measured 2026-10-12, 189 → the figure in
// 8bitscript.config.ts).
//
// No initializer on either: zero is "not sweeping".
let sweepCell: usmallint;
let sweepLeft: utinyint;

// The VIC-20's footer is one row: the copyright's until the sweep has run
// off its end, the status line's and the version's after. ui/ScoreBar.8bx
// and ui/Version.8bx print there only once footerFree(), and the sweep's
// last step raises footerDue so the frame loop (2048.8bs) puts them up —
// a Screen() during the sweep would have them erased by the cursor. Never
// raised anywhere else; the test that raises it is a build fact.
export let footerDue: bool;

export function footerFree(): bool {
    return copyrightDismissed && sweepLeft == 0;
}

export function dismissCopyright(): void {
    copyrightDismissed = true;
    if (!copyrightFits()) {
        return;
    }
    sweepCell = copyrightAt();
    sweepLeft = copyrightWidth() + 1;
    text.setReverse(true);
    text.putChar(sweepCell, SPACE);
    text.setReverse(false);
}

export function stepCopyright(): void {
    if (sweepLeft == 0) {
        return;
    }
    text.putChar(sweepCell, SPACE);
    sweepLeft = sweepLeft - 1;
    if (sweepLeft > 0) {
        sweepCell = sweepCell + 1;
        text.setReverse(true);
        text.putChar(sweepCell, SPACE);
        text.setReverse(false);
    } else if (!FLUID && text.COLUMNS < board.FULL_WIDTH) {
        footerDue = true;
    }
}
