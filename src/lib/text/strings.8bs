// Every line the game prints, in one place — the seam a translation fills.
// strings.de.8bs beside this file is the German one, and a build takes it
// with `8bs build --locale de`, a `locale: 'de'` on a target, or a
// `{ locale: 'de' }` release entry (8bitscript.config.ts); with no locale
// named, no locale's file is read and this one is the game, on every
// machine including the PET. Only the machine's own wording is ever in
// an image — the arm an element takes is a fact, and the rest fold away
// with their strings.
//
// A string's `.length` folds at compile time, so the centring reads it
// here rather than carrying a second number that could drift. Lines that
// overwrite one another (the three status lines of one arrangement) are
// one width each, padded, so a shorter one never leaves a glyph behind.
//
// The portable character set is space, 0-9, A-Z, a-z, and ! , - . : ? —
// no parentheses, which is why the copyright's "(C)" is put in by
// ui/title/Copyright.8bx as two codes after the print.

export const NAME: string = "2048";
export const SCORE_LABEL: string = "SCORE"; // followed by a space and five digits

// The title screen's prompt: the key this machine has.
export const PRESS_RETURN: string = "PRESS RETURN";
export const PRESS_START: string = "PRESS START";
export const PRESS_FIRE: string = "PRESS FIRE";
export const PRESS_RETURN_OR_START: string = "PRESS RETURN OR START";
export const PRESS_RETURN_OR_FIRE: string = "PRESS RETURN OR FIRE";
export const PRESS_ENTER: string = "PRESS ENTER"; // the web names its key
export const TOUCH_TO_START: string = "TOUCH TO START";

// The end of a game, and the way back.
export const GAME_OVER: string = "GAME OVER";
export const RETURN_TO_TRY_AGAIN: string = "PRESS RETURN TO TRY AGAIN";
export const RETURN_TO_TRY_AGAIN_NARROW: string = "RETURN TO TRY AGAIN"; // 22 columns
export const START_TO_TRY_AGAIN: string = "PRESS START TO TRY AGAIN";
export const FIRE_TO_TRY_AGAIN: string = "PRESS FIRE TO TRY AGAIN";
export const ENTER_TO_TRY_AGAIN: string = "PRESS ENTER TO TRY AGAIN";
export const ENTER_TO_TRY_AGAIN_NARROW: string = "ENTER TO TRY AGAIN";
export const TOUCH_TO_TRY_AGAIN: string = "TOUCH TO TRY AGAIN";

// The status line under the board — one width per arrangement.
export const STATUS_WON: string = "YOU MADE 2048 ";            // a fixed grid: 14
export const STATUS_MOVE: string = "ARROWS TO MOVE";
export const STATUS_CLEAR: string = "              ";
export const FLUID_STATUS_WON: string = "YOU WIN!       ";     // the fluid host, narrow: 15
export const FLUID_STATUS_MOVE: string = "SWIPE OR ARROWS";
export const FLUID_STATUS_CLEAR: string = "               ";
export const REPLICA_STATUS_WON: string = "YOU MADE 2048      "; // the web's fixed replicas: 19
export const REPLICA_STATUS_MOVE: string = "ARROWS TO MOVE     ";
export const REPLICA_STATUS_CLEAR: string = "                   ";

// The fluid host's WIDE arrangement: two five-wide lines in the margin.
export const HINT_SWIPE: string = "SWIPE";
export const HINT_ARROW: string = "ARROW";
export const HINT_WIN: string = "WIN! ";
export const HINT_CLEAR: string = "     ";

// The port's own copyright line; the original game's author is credited
// in README.md. The NES has no parentheses in its character set at all.
export const COPYRIGHT: string = " C  2026 8BITSCRIPT";
export const COPYRIGHT_WORD: string = "COPYRIGHT 2026 8BITSCRIPT";
