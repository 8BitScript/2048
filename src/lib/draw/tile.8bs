// One tile, through @8bitscript/text, on every machine but the PET —
// whose twin beside this file, tile.pet.8bs, stamps screen codes into
// video RAM instead (see there for the one reason it has to). The two
// primitives above drawTile() — the filled square and the block-digit
// glyph — are for the skins that stamp a tile's value from
// lib/draw/font.8bs (the fluid web host, the web's PET replica); a fixed
// grid paints its square inline in drawTile()'s other arm, the cheapest
// form there, and never links these two.
import { text } from "@8bitscript/text";
import { System, Video } from "@8bitscript/system";
import { POW2, GREY, TILE_COLOR, TILE_DIGITS } from "./palette.8bs";
import { DIGIT_TILES, TILE_DIGIT_AT, TILE_DIGIT } from "./font.8bs";
import { tileCell, tileW, tileH, rowWidth, BLOCK_DIGITS, blockDigitsFit } from "../layout/layout.8bs";

// This machine's row width on a fixed grid, so cell = y * ROW + x.
const ROW: usmallint = text.COLUMNS;

// What colour this tile is. Empty is GREY wherever color 12 is the C64's
// medium grey. The VIC-20 keeps only three bits of a character color, so
// 12 would land as purple; its web skin is 22 columns of the same palette.
// Both of those return the table unchanged, and the branch is a build
// fact, so neither image pays for a test.
function tileColor(exponent: utinyint): utinyint {
    if (#system() == System.VIC20 || (#system() == System.WEB && text.COLUMNS == 22)) {
        return TILE_COLOR[exponent];
    }
    if (exponent == 0) {
        return GREY;
    }
    return TILE_COLOR[exponent];
}

// The four corner cells, after the square is filled and while reverse is
// still on. The web font has a quarter-circle mask at 144–147 (the ink is
// the cut, and reverse punches it out), which is a real curve rather than
// the one-step chamfer a 2×2 block can draw. A Commodore screen code has
// only that chamfer — the PET QUAD table's three-quadrant entries — so
// reverse has to be off for the poke and back on before the digits.
// Machines without either glyph — Atari, NES, the X16's ISO set — keep
// square corners. The VIC-20's chamfer is omitted too: four pokes put the
// unexpanded build past $1E00.
function roundCorners(origin: usmallint, stride: usmallint): void {
    if (tileW < 2 || tileH < 2) {
        return;
    }
    let right: usmallint = tileW - 1;
    let bottom: usmallint = origin + (tileH - 1) * stride;
    if (#system() == System.WEB && Video.BLOCK_WIDTH == 2) {
        text.putChar(origin, 144);
        text.putChar(origin + right, 145);
        text.putChar(bottom, 146);
        text.putChar(bottom + right, 147);
        return;
    }
    if (#system() == System.C64 || #system() == System.C128 || #system() == System.VIC20 || #system() == System.MEGA65) {
        text.setReverse(false);
        text.putChar(origin, 254);
        text.putChar(origin + right, 252);
        text.putChar(bottom, 251);
        text.putChar(bottom + right, 236);
        text.setReverse(true);
    }
    return;
}

// Code 137 punches the top-left and bottom-right quadrants, so those two
// corners of an empty tile are already notched. The other two still have
// their outer quadrant filled; these two glyphs punch that quadrant and
// keep the same diagonal, so the empty tile stays half-density.
function roundDimCorners(origin: usmallint, stride: usmallint): void {
    let right: usmallint = tileW - 1;
    let bottom: usmallint = origin + (tileH - 1) * stride;
    text.putChar(origin + right, 141);
    text.putChar(bottom, 139);
    return;
}

// A tileW × tileH square of reverse video in the tile's colour, at origin.
// An empty tile on a host with no per-cell color (the web's PET replica)
// is a 50% block instead of a solid one, which is the grey that host can
// draw. Code 137 is the web's top-left + bottom-right quadrants.
export function fillTile(origin: usmallint, exponent: utinyint): void {
    text.setColor(tileColor(exponent));
    text.setReverse(true);
    let ink: utinyint = 32;
    if (exponent == 0 && !Video.COLOR_PER_CELL && #system() == System.WEB) {
        ink = 137;
    }
    let rowCell: usmallint = origin;
    let line: usmallint = 0;
    while (line < tileH) {
        text.fill(rowCell, tileW, ink);
        rowCell = rowCell + rowWidth;
        line++;
    }
    if (ink == 137) {
        roundDimCorners(origin, rowWidth);
    } else {
        roundCorners(origin, rowWidth);
    }
    return;
}

// One block digit: two glyphs per row, three rows, top-left at cell.
export function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        text.putChar(rowCell, DIGIT_TILES[base]);
        text.putChar(rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + rowWidth;
        row++;
    }
    return;
}

// One tile, through @8bitscript/text: a filled tileW × tileH square in the
// tile's colour, its value on the middle row. Two shapes, and BLOCK_DIGITS
// (a build fact) says which is in the image:
//
// - A grid with room for block digits (the fluid web host when its tile is
//   wide enough, the web's PET replica always): the square from
//   fillTile(), then 2×3 glyphs from lib/draw/font.8bs centred in it — or a
//   printed number when the tile is too narrow this frame.
// - Every other fixed grid: `text.setReverse(true)` turns a printed space
//   into a solid block in the current colour on every target (a plain
//   inverted block, no colour, on the machines with none), so the same
//   three calls draw a coloured square on a C64 and a monochrome one on an
//   Atari. The middle row's fill doubles as the field `printNumber` then
//   centres digits into (an odd leftover space, when tileW - width is odd,
//   falls to the right — `>> 1` truncates, never rounds up); the top and
//   bottom rows are blank on purpose — they are the rest of the square.
//
// ui/Tile.8bx is this call. A function with one caller is written
// into it (8bitscript #184), so the element costs what the inline drawing
// did.
export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let origin: usmallint = tileCell(row, col);
    if (BLOCK_DIGITS) {
        fillTile(origin, exponent);
        if (blockDigitsFit()) {
            // Digits are 2 cells wide and 3 rows tall. Across tileW that
            // is exact for every digit count, because both are even (the
            // layout keeps tileW even for exactly this). Down tileH it
            // cannot be in general, so the 3-row glyph block is centred in
            // whatever tileH this tile turned out to be.
            let base: utinyint = TILE_DIGIT_AT[exponent];
            let count: utinyint = TILE_DIGIT_AT[exponent + 1] - base;
            if (count != 0) {
                let vOffset: usmallint = (tileH - 3) >> 1;
                let at: usmallint = origin + vOffset * rowWidth + ((tileW >> 1) - count);
                let i: utinyint = 0;
                while (i < count) {
                    drawDigit(at, TILE_DIGIT[base + i]);
                    at = at + 2;
                    i++;
                }
            }
        } else {
            let value: usmallint = POW2[exponent];
            if (value != 0) {
                let width: utinyint = TILE_DIGITS[exponent];
                let mid: usmallint = tileH >> 1;
                let numRow: usmallint = origin + mid * rowWidth;
                let offset: usmallint = (tileW - width) >> 1;
                text.printNumber(numRow + offset, value, width);
            }
        }
    } else {
        let value: usmallint = POW2[exponent];
        text.setColor(tileColor(exponent));
        text.setReverse(true);
        // A row cursor rather than origin + line * ROW: the backend inlines
        // a 16-bit multiply at every site, and this one is inside a loop.
        let rowCell: usmallint = origin;
        let numRow: usmallint = origin;
        let mid: utinyint = tileH >> 1;
        let line: utinyint = 0;
        while (line < tileH) {
            text.fill(rowCell, tileW, 32);
            if (line == mid) {
                numRow = rowCell; // the row the digits go in, kept as the
                                  // cursor passes it rather than multiplied for
            }
            rowCell = rowCell + ROW;
            line++;
        }
        // Not the VIC-20: color 12 is not grey there (three-bit character
        // color), and four corner pokes put the unexpanded build 61 bytes
        // past $1E00 (measured 2026-09-21). The chamfer needs a glyph the
        // Atari, NES, and X16 text modes do not have either.
        if (#system() == System.WEB || #system() == System.C64 || #system() == System.C128 || #system() == System.MEGA65) {
            roundCorners(origin, ROW);
        }
        if (value != 0) {
            let width: utinyint = TILE_DIGITS[exponent];
            let offset: utinyint = (tileW - width) >> 1;
            text.printNumber(numRow + offset, value, width);
        }
    }
    text.setReverse(false); // so the next print — this frame's or the next — is not inverted
}
