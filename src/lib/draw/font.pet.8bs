// The PET's block-digit font — font.8bs's glyphs as screen codes for
// video RAM, matching @8bitscript/pet/blocks's DIGIT_TILES with bit 7
// flipped (inverted). The digit tables are the same as font.8bs's; the
// glyph codes are the one thing this machine has to spell differently.
export const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
export const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];

// Six screen codes per digit, index digit×6.
export const DIGIT_TILES: array<utinyint, 60> = [
    108, 225, 225, 225, 124, 225,
    126, 160, 123, 160, 126, 251,
    98,  225, 226, 225, 124, 251,
    98,  225, 226, 225, 226, 225,
    225, 225, 124, 225, 160, 225,
    108, 254, 124, 251, 226, 225,
    108, 254, 124, 251, 124, 225,
    98,  225, 160, 225, 160, 225,
    108, 225, 124, 225, 124, 225,
    108, 225, 124, 225, 226, 225,
];
