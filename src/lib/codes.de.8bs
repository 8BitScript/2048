// The German PET: lib/codes.8bs's twin for `--locale de`, generated from
// the same words strings.de.8bs prints elsewhere (A=1 … Z=26, digits,
// space and punctuation at their ASCII values in the graphics set). The
// runs, their lengths and where they go all change with the words —
// "RETURN DRUECKEN" is 15 where "PRESS RETURN" is 12, so the prompt
// starts two cells further left — and the positions are worked out here
// as data for the same reason codes.8bs's are: (columns − length) >> 1,
// per width. The version's six codes are the same as the English ones.
export const HUD: array<utinyint, 111> = [
    50, 48, 52, 56, 32, 32, 16, 21, 14, 11, 20, 5,  // "2048  PUNKTE" the header: the name, two spaces, the score's label
    16, 6, 5, 9, 12, 5, 32, 2, 5, 23, 5, 7, 5, 14,  // "PFEILE BEWEGEN" a status line (14)
    50, 48, 52, 56, 32, 7, 5, 19, 3, 8, 1, 6, 6, 20,  // "2048 GESCHAFFT" a status line (14)
    19, 16, 9, 5, 12, 32, 22, 15, 18, 2, 5, 9,  // "SPIEL VORBEI" GAME OVER (12)
    18, 5, 20, 21, 18, 14, 58, 32, 14, 5, 21, 5, 19, 32, 19, 16, 9, 5, 12,  // "RETURN: NEUES SPIEL" the retry prompt (19)
    40, 3, 41, 32, 50, 48, 50, 54, 32, 56, 2, 9, 20, 19, 3, 18, 9, 16, 20,  // "(C) 2026 8BITSCRIPT" the copyright (19)
    18, 5, 20, 21, 18, 14, 32, 4, 18, 21, 5, 3, 11, 5, 14,  // "RETURN DRUECKEN" the title screen's prompt (15)
    22, 48, 46, 49, 46, 52,  // "V0.1.4" the version (6) — unchanged; V is screen code 22
];

export namespace hud {
    const ARROWS: utinyint = 12;
    const WON: utinyint = 26;
    const OVER_TITLE: utinyint = 40;
    const OVER_TITLE_LEN: utinyint = 12;
    const OVER_PROMPT: utinyint = 52;
    const OVER_PROMPT_LEN: utinyint = 19;
    const COPYRIGHT: utinyint = 71;
    const COPYRIGHT_LEN: utinyint = 19;
    const TITLE_AT: utinyint = 0;
    const TITLE_LEN: utinyint = 4;
    const SCORE_LABEL_AT: utinyint = 6;
    const SCORE_LABEL_LEN: utinyint = 6;
    const STATUS_LEN: utinyint = 14;
    const SCORE_DIGITS_LEN: utinyint = 5;
    const TITLE_PRESS_RETURN: utinyint = 90;
    const TITLE_PRESS_RETURN_LEN: utinyint = 15;
    const TITLE_VERSION: utinyint = 105;
    const TITLE_VERSION_LEN: utinyint = 6;
}

export namespace at {
    const HEADER_40: usmallint = 2;
    const HEADER_80: usmallint = 22;
    const STATUS_40: usmallint = 962;
    const STATUS_80: usmallint = 1942;
    const TITLE_40: usmallint = 458;
    const TITLE_80: usmallint = 918;
    const PROMPT_40: usmallint = 532;       // row 13: "RETURN DRUECKEN", 15 wide
    const PROMPT_80: usmallint = 1072;
    const VERSION_40: usmallint = 994;
    const VERSION_80: usmallint = 1994;
    const COPYRIGHT_40: usmallint = 930;
    const COPYRIGHT_80: usmallint = 1870;
    const OVER_TITLE_40: usmallint = 254;   // row 6: "SPIEL VORBEI", 12 wide
    const OVER_TITLE_80: usmallint = 514;
    const OVER_PROMPT_40: usmallint = 730;  // row 18: "RETURN: NEUES SPIEL", 19 wide
    const OVER_PROMPT_80: usmallint = 1470;
}
