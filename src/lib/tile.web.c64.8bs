// Web C64 skin: 40×25, 6×4 reverse-video tiles — the same board
// tile.8bs draws on a real C64. Picked up when the web build's hardware
// tag is `c64`. Draws through @8bitscript/text; does not import tile.8bs
// or write $0400.
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";
import { raster, Slot } from "@8bitscript/raster";
import { BorderColor, BackgroundColor } from "@8bitscript/screen";

const VERSION_LINE: string = "v0.2.0";

const ROW: usmallint = text.COLUMNS; // 40
const TILE_W: utinyint = 6;
const TILE_H: utinyint = 4;
const BLANK: string = "      ";

const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

// boardTop 3, left 6, 6×4 tiles, 1-cell gaps (stride 7×5)
const ORIGIN: array<usmallint, 16> = [
    126, 133, 140, 147,
    326, 333, 340, 347,
    526, 533, 540, 547,
    726, 733, 740, 747,
];

const HEADER_AT: usmallint = 46;
const SCORE_HEADER_LEN: utinyint = 11;
const STATUS_AT: usmallint = 926;
const TITLE_AT: usmallint = 458;
const PROMPT_AT: usmallint = 534;
const TOUCH_PROMPT_AT: usmallint = 533;  // "TOUCH TO START" is two
                                          // characters longer, so it
                                          // centres two columns left
const VERSION_AT: usmallint = 994;

// ---- the game-over message ------------------------------------------------
//
// "GAME OVER" in the blank row between the first and second rows of tiles
// (row 7), how to play again in the row between the third and fourth (row
// 17), instead of one line under the board — the same two lines every other
// skin draws, at this skin's own numbers. Both rows are already empty (a
// gap row is the one thing drawTile() never touches), so the message costs
// the board nothing and leaves the position that ended the game in view.
// Each line is centred on the screen: (40 - length) / 2.
const OVER_AT: usmallint = 295;         // row 7, col 15 — "GAME OVER"
const OVER_TOUCH_AT: usmallint = 691;   // row 17, col 11 — "TOUCH TO TRY AGAIN"
const OVER_KEY_AT: usmallint = 688;     // row 17, col 8 — "PRESS ENTER TO TRY AGAIN"
// The status line is the only thing this skin erases: the game-over
// lines are cleared by main.8bs blanking the screen for the next game.
const STATUS_BLANK: string = "                   "; // 19 spaces

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.
const CREDIT_PORT_AT: usmallint = 930;
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

export function computeLayout(): void {
}

export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(TITLE_AT, "2048");
    if (input.touch()) {
        text.print(TOUCH_PROMPT_AT, "TOUCH TO START");
    } else {
        text.print(PROMPT_AT, "PRESS ENTER");
    }
    text.print(CREDIT_PORT_AT, " C  2026 8BITSCRIPT");
    text.putChar(CREDIT_PORT_AT, PAREN_OPEN);
    text.putChar(CREDIT_PORT_AT + 2, PAREN_CLOSE);
    text.print(VERSION_AT, VERSION_LINE);
    // The list, built once, in ascending line order — tile.8bs's shape at
    // this skin's numbers: the band opens a text row above the title,
    // the wobble rides the title's own eight scanlines, straightens out
    // on the band's last line, and the band closes a row below.
    raster.clear();
    raster.at(BAND_TOP - 8, Slot.BACKGROUND, BAND_BACKGROUND);
    raster.at(BAND_TOP - 8, Slot.BORDER, BAND_BORDER);
    for (let i: utinyint = 0; i < WOBBLE_ENTRIES; i++) {
        raster.at(BAND_TOP + i * 2, Slot.SCROLL_X, SINE[i]);
    }
    raster.at(BAND_TOP + 8, Slot.SCROLL_X, 0);
    raster.at(BAND_TOP + 16, Slot.BACKGROUND, BackgroundColor.BLACK);
    raster.at(BAND_TOP + 16, Slot.BORDER, BorderColor.BLUE);
    raster.enable();
    return;
}

export function drawHud(score: usmallint, over: bool, won: bool): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(HEADER_AT, "2048");
    text.print(text.COLUMNS - SCORE_HEADER_LEN, `SCORE ${score:5}`);
    // Always write the status line, never just leave it: the branch that
    // printed nothing is what used to strand a message across a restart on
    // a touch host, where ARROWS TO MOVE is suppressed.
    if (won) {
        text.print(STATUS_AT, "YOU MADE 2048      ");
    } else if (!over && !input.touch()) {
        text.print(STATUS_AT, "ARROWS TO MOVE     ");
    } else {
        text.print(STATUS_AT, STATUS_BLANK);
    }
    // Nothing erases these two lines: main.8bs blanks the screen when the
    // next game starts, which is the only way out of a finished game.
    if (over) {
        text.print(OVER_AT, "GAME OVER");
        if (input.touch()) {
            text.print(OVER_TOUCH_AT, "TOUCH TO TRY AGAIN");
        } else {
            text.print(OVER_KEY_AT, "PRESS ENTER TO TRY AGAIN");
        }
    }
    return;
}

function tileWidth(value: usmallint): utinyint {
    if (value >= 1000) {
        return 4;
    }
    if (value >= 100) {
        return 3;
    }
    if (value >= 10) {
        return 2;
    }
    return 1;
}

export function drawTile(row: utinyint, col: utinyint, exponent: utinyint): void {
    let origin: usmallint = ORIGIN[row * 4 + col];
    let value: usmallint = POW2[exponent];
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    let line: utinyint = 0;
    while (line < TILE_H) {
        text.print(origin + line * ROW, BLANK);
        line++;
    }
    if (value != 0) {
        let width: utinyint = tileWidth(value);
        let offset: utinyint = (TILE_W - width) >> 1;
        text.printNumber(origin + (TILE_H >> 1) * ROW + offset, value, width);
    }
    text.setReverse(false);
    return;
}

// ---- the title wobble -----------------------------------------------------
//
// The same treatment tile.8bs gives the real C64, at this skin's own
// numbers: the web answers #fact(video.raster) true, so the title screen
// gets the raster showpiece too — background and border switch colour a
// text row above "2048" and back a row below it, and the title row itself
// rides a sine-driven SCROLL_X wobble, one entry per two scanlines
// (fancy's measured pitch, kept so the two skins show the same picture).
// drawTitleScreen() builds the list; 2048.8bs's loop animates it
// (wobbleTitle) and tears it down (raster.disable) the moment the game
// starts, the same as on the real machine.
//
// XSCROLL 0-7 over 32 steps — fancy's own table, the one tile.8bs carries.
const SINE: array<utinyint, 32> = [
    4, 4, 5, 5, 6, 6, 7, 7, 7, 7, 7, 6, 6, 5, 5, 4,
    3, 3, 2, 2, 1, 1, 0, 0, 0, 0, 0, 1, 1, 2, 2, 3,
];

// The wobble covers the title's one text row: eight scanlines, four
// SCROLL_X entries at the two-line pitch. The colour band opens one text
// row above it and closes one below.
const WOBBLE_ENTRIES: utinyint = 4;
const BAND_BACKGROUND: utinyint = 2; // red behind the title
const BAND_BORDER: utinyint = 7;     // yellow beside it
const BAND_TOP: usmallint = 88;      // TITLE_AT's row (11) * 8 — "2048"'s first scanline

// Where the four SCROLL_X value bytes live in the list. No stride probe
// here, unlike tile.8bs: this skin only ever reads the web rasterline,
// whose entries are documented as three bytes with `entry` the byte
// offset (index * 3). The first SCROLL_X entry is index 2 — the two
// opening colour splits come first.
const WOBBLE_STRIDE: utinyint = 3;
const WOBBLE_FIRST: utinyint = 6;
let wobblePhase: utinyint = 0;

// One step of the wobble, called once per title-screen frame from
// 2048.8bs's loop: rewrite only the four SCROLL_X value bytes, right
// after waitFrame(), before the next paint reads the list.
export function wobbleTitle(): void {
    wobblePhase = (wobblePhase + 1) & 31;
    for (let i: utinyint = 0; i < WOBBLE_ENTRIES; i++) {
        raster.setValue(WOBBLE_FIRST + i * WOBBLE_STRIDE, SINE[(i + wobblePhase) & 31]);
    }
    return;
}
