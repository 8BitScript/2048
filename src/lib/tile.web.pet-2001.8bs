// Web PET 2001 skin: 40×25 block-digit tiles, green host, no per-cell
// color. HUD matches the 4K PET (PRESS RETURN, 2048 left / SCORE right).
// Picked up when the web build's hardware tag is `pet-2001`. Draws through
// @8bitscript/text; does not import tile.pet.8bs or write $8000.
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";


const ROW: usmallint = text.COLUMNS; // 40
const TILE_H: utinyint = 5;
const BLANK: string = "        ";

const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

export const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
export const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];

const DIGIT_TILES: array<utinyint, 60> = [
    142, 138, 138, 138, 139, 138,
    135, 128, 141, 128, 135, 130,
    140, 138, 131, 138, 139, 130,
    140, 138, 131, 138, 131, 138,
    138, 138, 139, 138, 128, 138,
    142, 136, 139, 130, 131, 138,
    142, 136, 139, 130, 139, 138,
    140, 138, 128, 138, 128, 138,
    142, 138, 139, 138, 139, 138,
    142, 138, 139, 138, 131, 138,
];

const ORIGIN: array<usmallint, 16> = [
    42, 51, 60, 69,
    282, 291, 300, 309,
    522, 531, 540, 549,
    762, 771, 780, 789,
];

// Every screen address this skin draws at, as one namespace so the
// elements in ui/ can import them: an imported bare number const does
// not survive the linker today, a namespace member does.
export namespace at {
    const HEADER: usmallint = 2;
    const STATUS: usmallint = 962;
    const TITLE: usmallint = 458;
    const PROMPT: usmallint = 534;
    const TOUCH_PROMPT: usmallint = 533;  // "TOUCH TO START" is two characters longer, so it centres two columns left
    const VERSION: usmallint = 994;
    const OVER: usmallint = 255;         // row 6, col 15 — "GAME OVER"
    const OVER_TOUCH: usmallint = 731;   // row 18, col 11 — "TOUCH TO TRY AGAIN"
    const OVER_KEY: usmallint = 727;     // row 18, col 7 — "PRESS RETURN TO TRY AGAIN"
    const CREDIT_PORT: usmallint = 930;
}

// ---- the game-over message ------------------------------------------------
//
// "GAME OVER" in the blank row between the first and second rows of tiles
// (row 6), how to play again in the row between the third and fourth (row
// 18), instead of one line under the board — the same two lines every other
// skin draws, at this skin's own numbers, and the same rows the 4K PET puts
// them on. Both are already empty (a gap row is the one thing <Tile />
// never touches), so the message costs the board nothing and leaves the
// position that ended the game in view. Each line is centred on the screen:
// (40 - length) / 2. Nothing here goes red the way the colour skins do —
// this host has no per-cell colour, and the message is already the only
// text inside the board.
// The status line is the only thing this skin erases: the game-over
// lines are cleared by main.8bs blanking the screen for the next game.

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.

export function computeLayout(): void {
}



export function fillTile(origin: usmallint): void {
    text.setColor(TextColor.WHITE);
    text.setReverse(true);
    let rowCell: usmallint = origin;
    let row: utinyint = 0;
    while (row < TILE_H) {
        text.print(rowCell, BLANK);
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

export function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        text.putChar(rowCell, DIGIT_TILES[base]);
        text.putChar(rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}


// The title wobble is tile.8bs's — the portable skin, read by the one
// 6502 machine with a per-scanline hook (the C64). The web answers
// #fact(video.raster) true too, but this skin draws its own title and
// does not take the effect up yet; an empty function here means the
// compiler deletes the call, and the game's raster.disable() at start is
// a no-op against a list that was never built.

// The tile is ui/Tile.web.pet-2001.8bx — the PET's own arrangement, over
// this skin's fillTile() and drawDigit().
export function tileCell(row: utinyint, col: utinyint): usmallint {
    return ORIGIN[row * 4 + col];
}

// The try-again prompt is this skin's wording — see the game-over note
// above — read by ui/GameOver.web.pet-2001.8bx; TRY_AGAIN_TOUCH is the
// same on every web skin and lives there.
export const TRY_AGAIN_KEY: string = "PRESS RETURN TO TRY AGAIN";

// The title screen is the fluid host's ui/TitleScreen.web.8bx and the
// elements it composes, which print at these positions — the fluid skin
// works them out per resize, this one has them as its own numbers — so
// this skin exposes the same names. wide is always true here: the credit
// line is never dropped on a fixed grid.
export let titleAt: usmallint = at.TITLE;
export let promptAt: usmallint = at.PROMPT;
export let touchPromptAt: usmallint = at.TOUCH_PROMPT;
export let versionAt: usmallint = at.VERSION;
export let creditPortAt: usmallint = at.CREDIT_PORT;
export let wide: bool = true;
export const START_KEY: string = "PRESS RETURN";

export const TITLE_WOBBLES: bool = false; // this skin draws its title without the raster effect
