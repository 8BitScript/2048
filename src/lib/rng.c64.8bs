// The C64's twin of rng.8bs: SID voice 3's noise oscillator ($D41B) in
// place of a software generator. Picked up automatically for C64 builds —
// nothing in main.8bs names this file.
//
// It exists because it is *smaller*, which is the only argument for reading
// hardware inside game logic rather than once at start-up. Against 0.6.2:
// 3844 bytes of program where the portable generator needs 3884, and 82
// bytes of RAM against 84. What goes away is the 16-bit multiply-and-add
// and the two bytes of generator state it steps; what stays is `% bound`,
// which every version needs.
//
// The price is replay. Every spawn reads a register, so a C64 game cannot
// be replayed from its start state or reproduced from a screenshot — see
// @8bitscript/c64/random's own header, which is where the reasoning for
// keeping that register behind a separate import lives.
//
// Note that package's warning about begin(): it claims voice 3 and writes
// $D418 as a whole known byte, because the SID's low registers are
// write-only and cannot be read back. It must therefore run before anything
// else touches the chip, and main() calls it as its first statement. A 2048
// that ever grows sound has to revisit this file, not merely add notes.
import { random } from "@8bitscript/c64/random";

export namespace rng {
    // Fastest-clocked noise on voice 3, silenced. First thing main() does.
    function begin(): void {
        random.begin();
    }

    // Nothing to step: the oscillator runs whether or not the program is
    // looking at it, which is the whole reason this twin is cheaper.
    function tick(): void {
    }

    function range(bound: utinyint): utinyint {
        return random.byte() % bound;
    }
}
