// The web's PET 2001 replica: 40×25, green host, no per-cell colour, and
// the 4K PET's own arrangement — 8×5 block-digit tiles, 2048 left and
// SCORE right on the top row, the status line on the last — drawn through
// @8bitscript/text rather than video RAM. Picked up when the web build's
// hardware tag is `pet-2001`. The same surface as layout.8bs, so the
// elements in ui/ are the same files; every number here is the PET's —
// layout.pet.8bs beside this file is the PET's own twin with the same
// numbers for both of its widths (the language has no re-export, so the
// two files say them twice).
import { text } from "@8bitscript/text";
import { i18n } from "@8bitscript/i18n";
import { Game, Prompt } from "@8bitscript/i18n/catalog";

const ROW: usmallint = text.COLUMNS; // 40

// ---- what the elements ask this skin ---------------------------------------


// Always block digits — an 8-wide tile has room for four of them, which
// is the whole point of the PET's arrangement.
export const BLOCK_DIGITS: bool = true;
export function blockDigitsFit(): bool {
    return true;
}

// The PET's key, in the PET's words: the elements print RETURN here, not
// the web's ENTER (src/i18n catalogs interpolate RETURN here).
export const ENTER_KEY: bool = false;

// Same as the PET: the copyright sits on the header row, between the
// name and the score. See layout.pet.8bs.
export const COPYRIGHT_ON_HEADER: bool = true;
export namespace board {
    const FULL_WIDTH: usmallint = 23;
}

// ---- the positions -------------------------------------------------------
//
// Top-left cell of each board square: (1 + row×6)×40 + 2 + col×9. Data,
// so an index replaces the multiply; boardTop 1, 8×5 tiles, 1-cell gaps.
const ORIGIN: array<usmallint, 16> = [
    42, 51, 60, 69,
    282, 291, 300, 309,
    522, 531, 540, 549,
    762, 771, 780, 789,
];

export let tileW: usmallint = 8;
export let tileH: utinyint = 5;
export let rowWidth: usmallint = 40;
export let boardLeft: usmallint = 2;
export let boardTop: usmallint = 1;
export let boardWidth: usmallint = 35;
export let headerAt: usmallint = 0;    // row 0: "2048" at col 2, SCORE at col 29
export let statusAt: usmallint = 962;  // row 24, col 2 — directly under the board
// "GAME OVER" in the blank row between the first and second rows of
// tiles (row 6), how to play again in the row between the third and
// fourth (row 18) — the rows the 4K PET puts them on, each centred:
// (40 - length) / 2, worked out in computeLayout() from the strings a
// build prints so a translation moves the line with the words (an
// initializer cannot be an expression, 8BS3001).
export let overAt: usmallint;        // row 6
export let overPromptAt: usmallint;  // row 18 — "PRESS RETURN TO TRY AGAIN"
export let overTouchAt: usmallint;   // row 18 — "TOUCH TO TRY AGAIN"
// The fluid host's own: never WIDE here, and never read.
export let wide: bool = true;
export let titleNameAt: usmallint = 0;
export let scoreLabelAt: usmallint = 0;
export let scoreValueAt: usmallint = 0;
export let hintTopAt: usmallint = 0;
export let hintBottomAt: usmallint = 0;
export let titleArtX: usmallint = 16;
export let titleArtY: usmallint = 0;

// Every number above is the build's. The three game-over lines are the
// only ones worked out here, and only because their length is the
// locale's.
export function computeLayout(): void {
    overAt = 6 * 40 + ((40 - Game.GAME_OVER.length) >> 1);
    overPromptAt = 18 * 40 + ((40 - i18n.format(Prompt.RETRY, { control: "RETURN" }).length) >> 1);
    overTouchAt = 18 * 40 + ((40 - Prompt.TOUCH_RETRY.length) >> 1);
}

export function tileCell(row: utinyint, col: utinyint): usmallint {
    return ORIGIN[row * 4 + col];
}
