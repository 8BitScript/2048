// A tile: layout (how big one is, where the board sits) and drawing (what
// one looks like) — the portable version, used by every target except the
// PET (tile.pet.8bs) and the web (tile.web.8bs), which read their own
// twins instead (see docs/packages.md's "System-specific files": the
// machine's name beside the plain filename is its own version, picked up
// with nothing in 2048.8bs or 8bs.config.ts naming it). Split out of
// 2048.8bs so those two can differ without duplicating the game's rules,
// board state, or input handling.
import { text, TextColor } from "@8bitscript/text";
import { raster, Slot } from "@8bitscript/raster";
import { BorderColor, BackgroundColor } from "@8bitscript/screen";
import { Input, System, Video } from "@8bitscript/system";

// Keep in sync with package.json "version".
const VERSION_LINE: string = "v0.2.0";
const VERSION_LEN: utinyint = 6;

// Exponent to face value — tile.8bs's own copy for drawing. The rules'
// table lives in 2048.8bs (score); the two never share a module, and
// the PET twin needs neither.
export const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

// Exponent to colour, on the six targets with per-cell colour — a
// deliberately empty function on the other three (PET, Atari 8-bit, NES;
// see @8bitscript/ui's AGENTS.md for why those three), so this program
// never has to ask `video.colorPerCell` itself: it draws the same calls
// everywhere, and the three machines that cannot colour a cell simply do
// not. Index 0 is the empty square's own colour now (every cell is a
// filled block — see drawTile()), not an unused slot — and it shares WHITE
// with the "2" tile rather than using BLACK, since the screen behind the
// board is black on every target: a black reverse block on a black
// background is invisible, which would leave the sixteen-square grid
// unreadable everywhere except the two or three occupied cells.
// How many digits 2^exponent has. A twelve-byte table instead of the chain
// of compares on the value that used to work it out: the compares cost the
// unexpanded VIC-20 six times what the table does, and the exponent is
// already in hand at every call site.
export const TILE_DIGITS: array<utinyint, 12> = [1, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4];

export const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,  // 0: empty
    TextColor.WHITE,  // 2
    TextColor.CYAN,   // 4
    TextColor.GREEN,  // 8
    TextColor.GREEN,  // 16
    TextColor.YELLOW, // 32
    TextColor.YELLOW, // 64
    TextColor.PURPLE, // 128
    TextColor.PURPLE, // 256
    TextColor.RED,    // 512
    TextColor.RED,    // 1024
    TextColor.BLUE,   // 2048
];

const ROW: usmallint = text.COLUMNS; // this machine's row width, so cell = y * ROW + x

// ---- layout -------------------------------------------------------------
//
// A tile is a filled block of reverse video, not a number in a strip: a
// solid square in TILE_COLOR[exponent] (a plain inverted block on the three
// machines with no per-cell colour), with a one-cell gap between tiles so
// the sixteen read as separate squares making up one big square, the way
// https://github.com/gabrielecirulli/2048 draws its own board — the gap
// matters more than it looks: without it, a whole row of empty (same-
// coloured) tiles fuses into one bar and the grid disappears (2026-09-07,
// screenshot, tried on the VIC-20). TILE_H is 3 so a tile reads as a square
// rather than a one-line strip: a blank row, the digits, another blank
// row, all three filled.
//
// A tile's WIDTH is the harder number, because it has two pulls in
// opposite directions. Five columns — one wider than "2048" itself needs —
// gives every digit count from one to four at least one spare cell to
// centre a number in; four was tried first and rejected (2026-09-07,
// screenshots): a 4-digit tile filled its whole width with no margin at
// all, and a 3-digit tile's one spare cell could only be pushed to one
// side, never split into a real margin either side. But four tiles five
// wide plus three one-cell gaps is 23 columns, one past the VIC-20's 22 —
// the only one of the nine targets this narrow — and dropping the gap to
// fit is the fused-row problem above. So the VIC-20 alone keeps the
// narrower, 4-wide tile (with its gap intact) and lives with tighter
// centring, while the C64 and the X16 take a larger tile that fills their
// own grids (6×4 and 12×8) and everyone else keeps five. `cellWidth` is a
// `let` decided once in computeLayout(), not a const, because 8BitScript's
// `const` only folds a literal or another const's bare name, never an
// expression or a branch — there is no compile-time `if` to give one
// machine a different literal (`switch` on `#system()` is designed, not
// built — docs/project/system-abstraction.md) — so the choice, like the
// centring itself, has to happen at run time, once, before the game loop
// starts.
//
// This centring is still only exact for an odd number of spare columns
// split in half by `>>`: a 2-digit number in a 5-wide tile lands 1 left, 2
// right, not 2 and 2 — the tile.pet.8bs version trades this text font for
// one built from PET block graphics specifically because a 2-cell-wide
// digit makes the leftover always even, and so exactly centred, for every
// digit count from one to four. See that file.
const FULL_TILE_W: utinyint = 5;
const NARROW_TILE_W: utinyint = 4; // the VIC-20's own width — see above
const DEFAULT_TILE_H: utinyint = 3;
// C64 text mode is 40×25 with the stock border; four 6×4 tiles plus gaps
// is 27×19, which still leaves a header row, status row, and margins
// (measured in cells, 2026-09-12, screenshot before this change).
const C64_TILE_W: utinyint = 6;
const C64_TILE_H: utinyint = 4;
// Commander X16 text is 76×56 inside the border inset. The portable 5×3
// tile that fits a 40-column machine occupies 23×15 of that — about a
// third of the width — and reads as a postage stamp (x16emu, 2026-09-13).
// 12×8 is 2× the C64's 6×4, the same 3:2 cell aspect, on a grid a little
// under twice as wide and more than twice as tall.
const CX16_TILE_W: utinyint = 12;
const CX16_TILE_H: utinyint = 8;
const COL_GAP: utinyint = 1; // between tile columns — always on, see above
const ROW_GAP: utinyint = 1; // between tile rows — never contended for room
const FULL_BOARD_WIDTH: usmallint = 23;   // 4 tiles * 5 + 3 gaps * 1
const NARROW_BOARD_WIDTH: usmallint = 19; // 4 tiles * 4 + 3 gaps * 1

// Where the board lands, and how wide one tile is — both worked out once
// in computeLayout() below rather than hand-picked per machine:
// `text.COLUMNS` and `Video.ROWS` are only known once a target is linked
// in, so centring the board on each one's own screen — a VIC-20's 22x23
// up to a Commander X16's 76x56 — has to happen at run time, not as a
// const. It is still one-time arithmetic, run once before the game loop
// starts, not repeated per frame or per tile.
export let cellWidth: usmallint = FULL_TILE_W;
export let tileH: utinyint = DEFAULT_TILE_H;
let leftMargin: usmallint = 0;
let headerRow: usmallint = 0;
let boardTop: usmallint = 0;
let statusRow: usmallint = 0;

// ---- the game-over message ----------------------------------------------
//
// "GAME OVER" goes in the blank row between the first and second rows of
// tiles and how to play again in the row between the third and fourth,
// instead of one line under the board. Those two gap rows are already empty
// on every target — they are the rows drawTile() never touches — so the
// message costs the board nothing and does not cover the position the
// player just lost on, which is the thing worth looking at when the game
// ends. They also sit symmetrically about the board's middle, so the pair
// reads as one message rather than two strings that happened to land in
// the gaps. Every skin does this; only the numbers differ (tile.pet.8bs
// and the tile.web.*.8bs twins have their own).
//
// The prompt names ONE input where the title screen names both: "PRESS
// RETURN OR FIRE TO TRY AGAIN" is 28 characters and the VIC-20's screen is
// 22. A machine with a keyboard always has RETURN, so that is the one it
// names; a machine without one has no fallback and names its own button.
//
// The VIC-20 drops the PRESS on top of that, because 25 characters do not
// fit on 22 columns either. Both the length and the text branch on
// text.COLUMNS, and both branches FOLD: the VIC-20 image carries only
// "RETURN TO TRY AGAIN" and every wider machine only "PRESS RETURN TO TRY
// AGAIN" (+4 and +10 bytes respectively, measured 2026-09-13 — exactly the
// one string each). The `const` limitation this file's layout notes
// describe is about const DECLARATIONS; a branch on a build-time constant
// still folds, the same way the Input.* arms below do.
const OVER_TITLE_LEN: utinyint = 9;         // "GAME OVER"
const OVER_KEY_LEN: utinyint = 25;          // "PRESS RETURN TO TRY AGAIN"
const OVER_KEY_NARROW_LEN: utinyint = 19;   // "RETURN TO TRY AGAIN"
const OVER_PAD_LEN: utinyint = 24;          // "PRESS START TO TRY AGAIN"
const OVER_STICK_LEN: utinyint = 23;        // "PRESS FIRE TO TRY AGAIN"

// Worked out once in computeLayout(), like the board itself: the gap rows
// move with tileH and the centring needs text.COLUMNS, neither of which is
// known until a target is linked in.
let overTitleAt: usmallint = 0;
let overPromptAt: usmallint = 0;

export function computeLayout(): void {
    // One arm per machine, each setting the tile size, rather than a
    // default set first and then overwritten: a branch on a build-time
    // fact folds, so whichever arm this build takes is the only one in
    // the image — but the assignments AHEAD of the branch are not dead
    // to the folder, and the narrow build was carrying the wider build's
    // stores because of it. The narrow test comes first because the C64
    // arm is 40 columns and could never reach it anyway.
    let boardWidth: usmallint = NARROW_BOARD_WIDTH;
    if (text.COLUMNS < FULL_BOARD_WIDTH) {
        cellWidth = NARROW_TILE_W;
        tileH = DEFAULT_TILE_H;
    } else if (#system() == System.C64) {
        cellWidth = C64_TILE_W;
        tileH = C64_TILE_H;
        boardWidth = 27;
    } else if (#system() == System.CX16) {
        cellWidth = CX16_TILE_W;
        tileH = CX16_TILE_H;
        boardWidth = 51; // 4 tiles * 12 + 3 gaps
    } else {
        cellWidth = FULL_TILE_W;
        tileH = DEFAULT_TILE_H;
        boardWidth = FULL_BOARD_WIDTH;
    }
    let boardHeight: usmallint = 4 * tileH + 3 * ROW_GAP;
    leftMargin = (text.COLUMNS - boardWidth) >> 1;
    let totalHeight: usmallint = boardHeight + 4; // header + gap + board + gap + status
    headerRow = (Video.ROWS - totalHeight) >> 1;
    boardTop = headerRow + 2; // header row, then one blank row, then the board
    statusRow = boardTop + boardHeight + 1; // one blank row after the board
    // The two gap rows the game-over message goes in: the one between the
    // first and second rows of tiles, and the one between the third and
    // fourth. A gap row is the row directly above the tile row that follows
    // it, so tileCell() — which already knows where a tile row lands —
    // gives both without a second copy of that arithmetic, and without a
    // second inlined 16-bit multiply, which the unexpanded VIC-20 has no
    // room for. leftMargin comes back off because these two lines are
    // centred on the screen rather than on the board.
    //
    // Only the arm this build takes survives folding, so naming one input
    // per machine costs the image exactly one prompt.
    overTitleAt = tileCell(1, 0) - ROW - leftMargin + ((text.COLUMNS - OVER_TITLE_LEN) >> 1);
    if (Input.KEYBOARD) {
        if (text.COLUMNS < FULL_BOARD_WIDTH) {
            overPromptAt = tileCell(3, 0) - ROW - leftMargin + ((text.COLUMNS - OVER_KEY_NARROW_LEN) >> 1);
        } else {
            overPromptAt = tileCell(3, 0) - ROW - leftMargin + ((text.COLUMNS - OVER_KEY_LEN) >> 1);
        }
    } else if (Input.PADS > 0) {
        overPromptAt = tileCell(3, 0) - ROW - leftMargin + ((text.COLUMNS - OVER_PAD_LEN) >> 1);
    } else {
        overPromptAt = tileCell(3, 0) - ROW - leftMargin + ((text.COLUMNS - OVER_STICK_LEN) >> 1);
    }
    return;
}

// The screen cell a tile's top-left corner starts at.
export function tileCell(row: utinyint, col: utinyint): usmallint {
    let y: usmallint = boardTop + row * (tileH + ROW_GAP);
    let x: usmallint = leftMargin + col * (cellWidth + COL_GAP);
    return y * ROW + x;
}

// ---- drawing --------------------------------------------------------------
//
// The tile itself is ui/Tile.8bx: it reads tileCell(), the layout above and
// the tables at the top of this file, and paints with @8bitscript/text.
// What follows is the rest of the skin — the HUD, the title, the wobble.
//
// A tile is a 4-character field, right-aligned, blanked first — never
// zero-padded: `text.printNumber` always writes exactly the width it is
// given, so a 3-digit "128" printed at width 4 would come out "0128". This
// clears the field to spaces and then asks for exactly as many digits as
// the value has, positioned at the field's right edge.

// Every tile — empty or not — is a filled cellWidth x TILE_H block of
// reverse video: `text.setReverse(true)` turns a printed space into a
// solid block in the current colour on all nine targets (a plain inverted
// block, no colour, on the three with none), so the same three calls draw
// a coloured square on a C64 and a monochrome one on a PET. `text.fill`
// writes `cellWidth` spaces — computeLayout() picked the width — so the
// same call fills the tile on a five-wide machine, the VIC-20's four, or
// the X16's twelve. The middle row's fill doubles as the field
// `printNumber` then centres digits into (an odd leftover space, when
// cellWidth - width is odd, falls to the right — `>> 1` truncates, never
// rounds up); the top and bottom rows are blank on purpose — they are the
// rest of the square, not wasted space.

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the two glyphs poked in after — putChar
// writes a glyph and nothing else, and the print is what put the colour on
// those cells. Every machine's putChar takes the character in ASCII (the
// web host's font is ASCII-indexed outright), so 40 and 41 are the same two
// numbers everywhere.
//
// Everywhere except the NES, whose font draws both as blank tiles
// (packages/nes/native/6502/font.s: "$22-$2B ... 10 blank tiles"), so it
// spells COPYRIGHT out instead. #system() folds, so each image carries one
// of the two. The placeholder is a space rather than a marker character for
// the same reason: if a machine ever did drop the poke, the line degrades
// to "C 2026 8BITSCRIPT" rather than showing punctuation nobody meant.
const CREDIT_PORT_LEN: utinyint = 19;      // "(C) 2026 8BITSCRIPT"
const CREDIT_PORT_WORD_LEN: utinyint = 25; // "COPYRIGHT 2026 8BITSCRIPT"
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

// ---- the title wobble -----------------------------------------------------
//
// On a machine with a per-scanline hook — #fact(video.raster), true only
// for the C64 among the targets that read this file — the title screen
// gets the raster showpiece the fancy example established
// (packages/examples/fancy in the 8bitscript repository): background and
// border switch colour a text row above "2048" and back a row below it,
// and the title row itself rides a sine-driven SCROLL_X wobble, one entry
// per TWO scanlines. That pitch is fancy's measured C64 constraint (a
// per-line cascade collapses the effect — see that example's header), not
// a choice made here. Everywhere the fact answers false, every branch on
// HAS_RASTER folds away and this whole section costs the image nothing —
// the 4K PET and the unexpanded VIC-20 are byte-identical with and
// without it (and the PET reads tile.pet.8bs anyway).
const HAS_RASTER: bool = #fact(video.raster);

// XSCROLL 0-7 over 32 steps — fancy's own table, verified on screen by
// packages/c64/test/wobble-probe.8bs, so the wave is a known-good shape.
const SINE: array<utinyint, 32> = [
    4, 4, 5, 5, 6, 6, 7, 7, 7, 7, 7, 6, 6, 5, 5, 4,
    3, 3, 2, 2, 1, 1, 0, 0, 0, 0, 0, 1, 1, 2, 2, 3,
];

// The wobble covers the title's one text row: eight scanlines, four
// SCROLL_X entries at the two-line pitch. The colour band opens one text
// row above it and closes one below, fancy's shape scaled to one row.
const WOBBLE_ENTRIES: utinyint = 4;
const BAND_BACKGROUND: utinyint = 2; // red behind the title
const BAND_BORDER: utinyint = 7;     // yellow beside it — also the stride probe's known value

// The wobble's walk through the sine table, and the two numbers the
// per-frame rewrite needs: bytes per entry in setValue's unit (probed the
// way fancy probes it — offset 3 names entry 1 where entries are three
// bytes and is refused untouched where they are four), and the byte
// offset of the first SCROLL_X entry (index 2 — the two opening colour
// splits come first). Only ever touched inside `if (HAS_RASTER)`.
let wobblePhase: utinyint = 0;
let wobbleStride: utinyint = 0;
let wobbleFirst: utinyint = 0;

// One step of the wobble, called once per title-screen frame from
// 2048.8bs's loop: rewrite only the four SCROLL_X value bytes, right
// after waitFrame(), before the raster reaches the band. On a machine
// with no raster this folds to an empty function and the compiler
// deletes the call — the same way text.setColor costs the PET nothing.
// The twins (tile.pet.8bs, tile.web.*.8bs) export their own empty copy:
// the PET has no raster, and the web skins draw their own title and do
// not take the effect up yet.
export function wobbleTitle(): void {
    if (HAS_RASTER) {
        wobblePhase = (wobblePhase + 1) & 31;
        for (let i: utinyint = 0; i < WOBBLE_ENTRIES; i++) {
            raster.setValue(wobbleFirst + i * wobbleStride, SINE[(i + wobblePhase) & 31]);
        }
    }
    return;
}

// Front door before the first deal. Prompt text is picked from Input.*
// facts, so unused strings never reach the image (optimizeReachable folds
// the other arms and the 6502 backend only emits referenced literals).
//
// A stick or pad cannot be probed the way a 1351 can (`mouse.present()`):
// an idle CIA/PIA port reads the same with nothing plugged in as with a
// stick at rest. So a keyboard machine that *has* joystick or pad ports
// always names both confirm inputs; FIRE or START alone is only for a
// build with no keyboard (the NES).
export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(((Video.ROWS >> 1) - 1) * ROW + ((text.COLUMNS - 4) >> 1), "2048");
    if (Input.PADS > 0) {
        if (Input.KEYBOARD) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - 21) >> 1), "PRESS RETURN OR START");
        } else {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - 11) >> 1), "PRESS START");
        }
    } else if (Input.JOYSTICKS > 0) {
        if (Input.KEYBOARD) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - 20) >> 1), "PRESS RETURN OR FIRE");
        } else {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - 10) >> 1), "PRESS FIRE");
        }
    } else {
        text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - 12) >> 1), "PRESS RETURN");
    }
    if (#system() == System.NES) {
        text.print((Video.ROWS - 2) * ROW + ((text.COLUMNS - CREDIT_PORT_WORD_LEN) >> 1), "COPYRIGHT 2026 8BITSCRIPT");
    } else {
        text.print((Video.ROWS - 2) * ROW + ((text.COLUMNS - CREDIT_PORT_LEN) >> 1), " C  2026 8BITSCRIPT");
        text.putChar((Video.ROWS - 2) * ROW + ((text.COLUMNS - CREDIT_PORT_LEN) >> 1), PAREN_OPEN);
        text.putChar((Video.ROWS - 2) * ROW + ((text.COLUMNS - CREDIT_PORT_LEN) >> 1) + 2, PAREN_CLOSE);
    }
    text.print((Video.ROWS - 1) * ROW + text.COLUMNS - VERSION_LEN, VERSION_LINE);
    if (HAS_RASTER) {
        // The list, built once, in ascending line order: the title's text
        // row starts at picture line row * 8, the band opens a row above
        // and closes a row below, and the wobble straightens out on the
        // band's last line. 2048.8bs's loop animates it (wobbleTitle) and
        // tears it down (raster.disable) the moment the game starts.
        let bandTop: utinyint = ((Video.ROWS >> 1) - 1) * 8;
        raster.clear();
        raster.at(bandTop - 8, Slot.BACKGROUND, BAND_BACKGROUND);
        raster.at(bandTop - 8, Slot.BORDER, BAND_BORDER);
        for (let i: utinyint = 0; i < WOBBLE_ENTRIES; i++) {
            raster.at(bandTop + i * 2, Slot.SCROLL_X, SINE[i]);
        }
        raster.at(bandTop + 8, Slot.SCROLL_X, 0);
        raster.at(bandTop + 16, Slot.BACKGROUND, BackgroundColor.BLACK);
        raster.at(bandTop + 16, Slot.BORDER, BorderColor.BLUE);

        // The stride probe, exactly as fancy runs it: offset 3 is entry 1
        // (the BAND_BORDER split) where entries are three bytes, and
        // misaligned — refused untouched — where they are four. The value
        // written is the value entry 1 already holds, so the list is the
        // same afterwards either way; only the returned bool differs.
        wobbleStride = 4;
        if (raster.setValue(3, BAND_BORDER)) {
            wobbleStride = 3;
        }
        wobbleFirst = wobbleStride * 2;

        raster.enable();
    }
    return;
}

const SCORE_HEADER_LEN: utinyint = 11; // "SCORE " plus a five-digit score field

export function drawHud(score: usmallint, over: bool, won: bool): void {
    let headerAt: usmallint = headerRow * ROW;
    // The status row's address joins it as a local rather than being written
    // out in each arm below: the 6502 backend inlines a 16-bit multiply at
    // every site, so three copies of statusRow * ROW is three multiplies.
    // Hoisting it is most of what paid for the message this function now
    // draws, on the unexpanded VIC-20 that had under a hundred bytes spare.
    let statusAt: usmallint = statusRow * ROW + leftMargin;
    text.setColor(TextColor.WHITE);
    text.print(headerAt + leftMargin, "2048");
    text.print(headerAt + text.COLUMNS - SCORE_HEADER_LEN, `SCORE ${score:5}`);
    // The status line no longer announces the end of the game — the board
    // does — so it goes blank rather than keeping ARROWS TO MOVE up under a
    // board that cannot move. Always write it, never just leave it: the
    // branch that printed nothing is what strands a message across a
    // restart. All three are 14 wide, the length of the longest, so a
    // shorter one never leaves a leftover glyph — that width was 19 while
    // GAME OVER - RESTART still lived here.
    if (won) {
        text.print(statusAt, "YOU MADE 2048 ");
    } else if (!over) {
        text.print(statusAt, "ARROWS TO MOVE");
    } else {
        text.print(statusAt, "              ");
    }
    // Nothing erases these two lines: 2048.8bs blanks the screen when the
    // next game starts, which is the only way out of a finished game.
    if (over) {
        text.print(overTitleAt, "GAME OVER");
        if (Input.KEYBOARD) {
            if (text.COLUMNS < FULL_BOARD_WIDTH) {
                text.print(overPromptAt, "RETURN TO TRY AGAIN");
            } else {
                text.print(overPromptAt, "PRESS RETURN TO TRY AGAIN");
            }
        } else if (Input.PADS > 0) {
            text.print(overPromptAt, "PRESS START TO TRY AGAIN");
        } else {
            text.print(overPromptAt, "PRESS FIRE TO TRY AGAIN");
        }
    }
    return;
}

