// Web VIC-20 skin: 22×23, 4-wide tiles with a one-cell gap — the same
// board tile.8bs draws on a real VIC-20. Picked up when the web build's
// hardware tag is `vic20`.
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";


const ROW: usmallint = text.COLUMNS; // 22
const TILE_W: utinyint = 4;
const TILE_H: utinyint = 3;

export const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

export const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

// boardTop 4, left 1, 4×3 tiles, 1-cell gaps (stride 5×4)
const ORIGIN: array<usmallint, 16> = [
    89, 94, 99, 104,
    177, 182, 187, 192,
    265, 270, 275, 280,
    353, 358, 363, 368,
];

// Every screen address this skin draws at, as one namespace so the
// elements in ui/ can import them: an imported bare number const does
// not survive the linker today, a namespace member does.
export namespace at {
    const HEADER: usmallint = 45;
    const STATUS: usmallint = 441;
    const TITLE: usmallint = 229;
    const PROMPT: usmallint = 269;
    const TOUCH_PROMPT: usmallint = 268;  // "TOUCH TO START" is two characters longer, so it centres two columns left
    const VERSION: usmallint = 500;
    const OVER: usmallint = 160;         // row 7, col 6 — "GAME OVER"
    const OVER_TOUCH: usmallint = 332;   // row 15, col 2 — both prompts are 18,
    const OVER_KEY: usmallint = 332;     // so both go at the same cell
    const CREDIT_PORT: usmallint = 463;
}

// ---- the game-over message ------------------------------------------------
//
// "GAME OVER" in the blank row between the first and second rows of tiles
// (row 7), how to play again in the row between the third and fourth (row
// 15), instead of one line under the board — the same two lines every other
// skin draws, at this skin's own numbers. Both rows are already empty (a
// gap row is the one thing <Tile /> never touches), so the message costs
// the board nothing and leaves the position that ended the game in view.
// Each line is centred on the screen: (22 - length) / 2, which is what
// decides the wording. PRESS ENTER TO TRY AGAIN, which the 40- and
// 48-column skins say, is 24 characters and would not fit on the screen at
// all — and at 20 characters even PRESS ENTER TO RETRY ran the full width
// of the row, reading as a bar across the board rather than a line inside
// it (2026-09-13, screenshot). So this skin drops the PRESS, and both
// prompts are 18 characters at the same column.
// One blank as wide as the longest line, from the column that line starts
// in: it covers either gap row, and the 19-column status line as well.
// The status line is the only thing this skin erases: the game-over
// lines are cleared by main.8bs blanking the screen for the next game.

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.

export function computeLayout(): void {
}





// The title wobble is tile.8bs's — the portable skin, read by the one
// 6502 machine with a per-scanline hook (the C64). The web answers
// #fact(video.raster) true too, but this skin draws its own title and
// does not take the effect up yet; an empty function here means the
// compiler deletes the call, and the game's raster.disable() at start is
// a no-op against a list that was never built.

// The tile is ui/Tile.8bx, the portable one, so this skin exposes the same
// names lib/tile.8bs does: where a tile is, its size, and how many digits
// a value has. cellWidth and tileH are lets because Tile.8bx reads them as
// the portable skin's lets — an imported scalar const does not survive the
// linker today (8bitscript: "no type on this IR node").
export const TILE_DIGITS: array<utinyint, 12> = [1, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4];
export let cellWidth: usmallint = TILE_W;
export let tileH: utinyint = TILE_H;

export function tileCell(row: utinyint, col: utinyint): usmallint {
    return ORIGIN[row * 4 + col];
}

// The try-again prompt is this skin's wording — see the game-over note
// above — read by ui/GameOver.web.vic20.8bx; TRY_AGAIN_TOUCH is the
// same on every web skin and lives there.
export const TRY_AGAIN_KEY: string = "ENTER TO TRY AGAIN";

// The title screen is the fluid host's ui/TitleScreen.web.8bx and the
// elements it composes, which print at these positions — the fluid skin
// works them out per resize, this one has them as its own numbers — so
// this skin exposes the same names. wide is always true here: the credit
// line is never dropped on a fixed grid.
export let titleAt: usmallint = at.TITLE;
export let promptAt: usmallint = at.PROMPT;
export let touchPromptAt: usmallint = at.TOUCH_PROMPT;
export let versionAt: usmallint = at.VERSION;
export let creditPortAt: usmallint = at.CREDIT_PORT;
export let wide: bool = true;
export const START_KEY: string = "PRESS ENTER";

export const TITLE_WOBBLES: bool = false; // this skin draws its title without the raster effect
