// The web's tile — the browser's Modern host, whose grid can change shape
// after the game has started (screen.RESIZABLE), so nothing below is a
// fixed cell number: computeLayout() reads text.columns()/text.rows() and
// works every position out from there, and main.8bs calls it again
// whenever screen.resized() reports the window changed shape. Picked up
// automatically for untagged web builds — nothing in main.8bs names this
// file; see docs/packages.md's "System-specific files". Machine skins are
// tile.web.<tag>.8bs, and those stay faithful to their machine: only this
// file is free to be laid out for a browser.
//
// ---- two arrangements, and a tile size neither hard-codes -----------------
//
// A landscape window has columns to spare and rows are the scarce thing:
// the WIDE arrangement (reverse-video tiles with 2×3-cell block-digits, a
// HUD down the side margins) spends those spare columns on the HUD so
// every row goes to the board. See "why the HUD is in the margins" below
// for the rest of that reasoning; it holds at any width the WIDE board
// plus its margins fits in — which is 48 columns and up, this skin's
// original baseline, not a number picked to look right on one screen.
//
// A portrait phone inverts that: rotate one and the live grid can drop to
// as few as 24 columns (web-layout.mjs's MIN_COLUMNS), nowhere near what
// WIDE needs, while rows are the thing there is plenty of. Below the WIDE
// threshold this file switches to the NARROW arrangement: tile.8bs's own
// shape, title and score stacked in a header row above the board and the
// move hint in a status row below it, because a header/status row costs a
// row each, which a narrow window actually has, rather than a margin
// column, which it does not.
//
// Neither arrangement's tile size is fixed. A window that is merely
// narrower than 48 columns and one that is a genuine phone portrait both
// take the NARROW arrangement, but a tile sized for the second would be a
// postage stamp on the first — and a square-ish window (as much room top
// to bottom as side to side) is exactly the shape a fixed "tall" and
// "wide" pair can't serve well, because it is neither. computeLayout()
// below works tileW and tileH out independently, each the biggest that
// fits four of it plus gaps on its own axis, plus whatever that
// arrangement's HUD needs there — not forced equal, the same way WIDE's
// own 8×5 tile isn't: a live grid almost always has less room on rows
// than columns for the NARROW arrangement (its header/status stack costs
// rows the way WIDE's side margins cost columns), so forcing a square tile
// would cap the width at whatever the row axis alone allows. The board
// and every HUD position then follow from tileW/tileH the same way they
// already followed from a fixed pair.
//
// Both arrangements answer computeLayout()/tileCell() the same way, so
// <Tile />'s caller never needs to know which one a frame
// is in; `wide` below picks the arrangement once each time the grid
// changes shape, and every drawing function branches on it exactly once.
//
// ---- why the HUD is in the margins (the WIDE arrangement) -----------------
//
// Rows are the scarcer thing on this screen and columns usually are not: at
// the 48×27 baseline, a board of four tiles plus three 1-row gaps is
// 4×tileH + 3 of those 27 rows. A HUD row across the top would cap tileH —
// fewer rows of board, and the rest left over doing nothing. On a phone in
// landscape that showed up as exactly what it was: a strip of empty screen
// under the board, because the status line is suppressed on a touch host and
// the version only appears on the title screen.
//
// Putting the HUD in the side margins instead spends columns, which there
// usually are enough of, and gives every row to the board.
//
// The tile is kept even, not odd, for the same reason it was fixed at 8
// to begin with: a digit is two cells wide in the block-digit font, so a
// run of them is always an even number of cells — on an odd tile it can
// only ever sit half a cell off centre, and on an even one it is exact
// for one, two, three, and four digits alike.
import { screen, BorderColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";

// Keep in sync with package.json "version".
const VERSION_LINE: string = "v0.2.0";

// The live grid, not a fixed 48: this skin runs on the Modern host's
// resizable preset, so a rotated phone or a resized window hands the
// program a different text.columns()/text.rows() and computeLayout()
// below reworks every position from it — the same "worked out once, not
// hand-picked" move tile.8bs's own computeLayout() already makes for the
// nine machines, applied here for the one target whose grid can also
// change after the game has started (main.8bs calls this again whenever
// screen.resized() says so).
export let rowWidth: usmallint = 0; // this frame's row width, so cell = y * rowWidth + x
let gridRows: usmallint = 0; // this frame's row count

// Which arrangement this frame is in — see the header comment. A `let`,
// not a `const`: it depends on the live rowWidth, which can change after
// the game has started.
export let wide: bool = true;

// Below this many columns the WIDE arrangement's margins have nowhere
// near enough room: this is this skin's own historical baseline (48×27),
// not a number chosen to make one screenshot look right, and
// computeLayout()'s WIDE branch reproduces the original 8×5 tile exactly
// at this width.
const WIDE_MIN_COLUMNS: usmallint = 48;

// Columns computeLayout() reserves outside the WIDE board for the side
// margins — 6 for the widest field (VERSION_LINE) plus a gap column on
// the right, 6 on the left for symmetry: 13 total, which is exactly what
// the original 48-wide, 35-board design left over.
const WIDE_MARGIN_COLUMNS: usmallint = 13;
// Rows computeLayout() reserves above and below the WIDE board so a tall
// WIDE window still gets a little breathing room instead of the board
// touching the screen's own top and bottom edges — 2 each, matching the
// original 48×27 design's own margin.
const WIDE_MARGIN_ROWS: usmallint = 4;

// The smallest and largest tile either arrangement will pick, so a huge
// window doesn't get a comically large board and a barely-fitting one
// doesn't get a tile too small to hold "2048"'s four digits. WIDE's
// width floor/ceiling are the historical 8 (this skin's original tile)
// and a generous double that; its height floor/ceiling are lower because
// a tile reads as a square on screen and WIDE's width already has the
// side margins competing for columns, so its height has more room to
// grow before it would look odd next to its own width. NARROW's floor is
// tile.8bs's own 5-wide board's quarter (its board never needed a digit
// wider than four characters either) and shares WIDE's width ceiling —
// NARROW is square, so one pair of limits covers both axes.
const WIDE_TILE_MIN: usmallint = 8;
const WIDE_TILE_MAX: usmallint = 20;
const WIDE_TILE_H_MIN: usmallint = 5;
const WIDE_TILE_H_MAX: usmallint = 14;
const NARROW_TILE_MIN: usmallint = 4;
const NARROW_TILE_MAX: usmallint = 16;

// The block-digit font needs 2 cells per digit, 4 digits wide for "2048" —
// the same 8 WIDE_TILE_MIN already guarantees there. Tile.web.8bx reads this
// directly, not `wide`: WIDE's own tileW floor already clears it every
// time, and NARROW's continuous square tile clears it whenever the live
// grid has the room, which is most shapes wider than a true phone
// portrait — the block font is what "big" looks like, and a tile that can
// fit it should use it regardless of which arrangement chose that size.
// Only where NARROW's own floor (4) is still binding — a live grid too
// narrow for both a bigger square tile and this — does a tile fall back
// to the plain printed digit Tile.web.8bx's narrow branch draws.
const BLOCK_DIGIT_MIN: usmallint = WIDE_TILE_MIN;

// This frame's tile size and board footprint, worked out by
// computeLayout() below from the live grid, the chosen arrangement, and
// the constants above. Every other position below is worked out from
// these, the same way tile.8bs's own cellWidth/tileH are.
export let tileW: usmallint = 8;
export let tileH: usmallint = 5; // this skin's original WIDE tile, until computeLayout() runs
export let boardWidth: usmallint = 35;
let boardHeight: usmallint = 23;

export const POW2: array<usmallint, 12> = [0, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048];

const TILE_COLOR: array<utinyint, 12> = [
    TextColor.WHITE,
    TextColor.WHITE,
    TextColor.CYAN,
    TextColor.GREEN,
    TextColor.GREEN,
    TextColor.YELLOW,
    TextColor.YELLOW,
    TextColor.PURPLE,
    TextColor.PURPLE,
    TextColor.RED,
    TextColor.RED,
    TextColor.BLUE,
];

// ---- the WIDE arrangement's block-digit font -------------------------------
//
// Each digit is 3 half-cells of ink on a 4 half-cell pitch, so a run of them
// is always an ODD number of half-cells inside an EVEN tile. Centring it
// wants a half-cell offset and the character grid only places whole cells, so
// the ink can land 2px either side of the tile's centre and nowhere between.
// The gap rides behind the digits, which puts the ink on the left of those
// two — the side with the smaller leftover margin. Moving the gap in front of
// them (add 1 to the left column of every pair) puts it on the right instead.
// True centre needs a digit whose ink is an EVEN number of half-cells wide:
// a redesigned font, not a repositioning.
export const TILE_DIGIT_AT: array<utinyint, 13> = [0, 0, 1, 2, 3, 5, 7, 9, 12, 15, 18, 22, 26];
export const TILE_DIGIT: array<utinyint, 26> = [
    2, 4, 8,
    1, 6, 3, 2, 6, 4,
    1, 2, 8, 2, 5, 6, 5, 1, 2,
    1, 0, 2, 4, 2, 0, 4, 8,
];
const DIGIT_TILES: array<utinyint, 60> = [
    142, 138, 138, 138, 139, 138,
    135, 128, 141, 128, 135, 130,
    140, 138, 131, 138, 139, 130,
    140, 138, 131, 138, 131, 138,
    138, 138, 139, 138, 128, 138,
    142, 136, 139, 130, 131, 138,
    142, 136, 139, 130, 139, 138,
    140, 138, 128, 138, 128, 138,
    142, 138, 139, 138, 139, 138,
    142, 138, 139, 138, 131, 138,
];

// The NARROW arrangement's digit widths — tile.8bs's own TILE_DIGITS: how
// many decimal digits 2^exponent has, so a plain printed number can be
// centred in a NARROW_TILE_W-wide tile the same way tile.8bs centres it
// in cellWidth.
export const NARROW_TILE_DIGITS: array<utinyint, 12> = [1, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4];

// Lengths of every string a layout position below centres or right-aligns —
// named once here rather than repeated as a magic number at each call site,
// the same way tile.8bs names OVER_TITLE_LEN and friends.
const TITLE_LEN: utinyint = 4;          // "2048"
const PROMPT_LEN: utinyint = 11;        // "PRESS ENTER"
const TOUCH_PROMPT_LEN: utinyint = 14;  // "TOUCH TO START"
const CREDIT_PORT_LEN: utinyint = 19;   // " C  2026 8BITSCRIPT"
const OVER_TITLE_LEN: utinyint = 9;     // "GAME OVER"
const OVER_TOUCH_LEN: utinyint = 18;    // "TOUCH TO TRY AGAIN"
const OVER_KEY_LEN: utinyint = 24;      // "PRESS ENTER TO TRY AGAIN"
const RIGHT_HUD_WIDTH: utinyint = 6;    // "v0.2.0" — the widest field rightAt anchors

// Where the board sits, and every HUD position around it — all worked out
// once in computeLayout() below, the same way tile.8bs's own leftMargin/
// boardTop/overTitleAt are: the live grid is a `run` fact on this target's
// Modern host, not a `build` one, so none of this can be a `const`. Unlike
// the nine machines, computeLayout() here can run more than once a
// session — main.8bs calls it again whenever screen.resized() reports the
// window changed shape.
export let boardLeft: usmallint = 0;
let boardTop: usmallint = 0;

// ---- WIDE-only HUD positions (the side margins) ----------------------------
export let titleNameAt: usmallint = 0;   // level with the board's top, left of it
export let scoreLabelAt: usmallint = 0;  // level with the board's top, right of it
export let scoreValueAt: usmallint = 0;  // one row under the score label
export let hintTopAt: usmallint = 0;     // two 5-column lines against the board's
export let hintBottomAt: usmallint = 0;  // last two rows, on the right

// ---- NARROW-only HUD positions (header row above, status row below) -------
export let headerAt: usmallint = 0;   // the header row's own start-of-row cell
export let statusAt: usmallint = 0;   // the status row, left-aligned on the board

// ---- title screen positions (both arrangements) ----------------------------
let titleAt: usmallint = 0;       // "2048" on the title screen
let promptAt: usmallint = 0;
let touchPromptAt: usmallint = 0; // "TOUCH TO START" is longer than
                                   // promptAt's text, so it centres
                                   // differently
let versionAt: usmallint = 0;

// ---- the game-over message ------------------------------------------------
//
// Two lines laid into the board's own gap rows rather than a panel over it:
// "GAME OVER" in the blank row between the first and second rows of tiles,
// and how to play again in the row between the third and fourth. A panel
// covers the board at the one moment the board is most worth looking at —
// the position you lost on — and these two rows are the only ones on the
// screen that are already empty, so the message costs the board nothing.
// Both lines sit symmetrically about the board's middle in both
// arrangements, which is what makes the pair read as one message rather
// than two strings that happened to land in the gaps.
//
// Both lines are centred the way the title screen centres its own: start
// column is (rowWidth - length) / 2, on the live rowWidth rather than a
// fixed 48. Both lines are white: red was tried for the title
// (2026-09-13, screenshot) and came out dimmer than the white prompt
// under it — the wrong way round for the line that matters more. The red
// the panel used to carry survives as the screen border.
export let overAt: usmallint = 0;       // "GAME OVER"
export let overTouchAt: usmallint = 0;  // "TOUCH TO TRY AGAIN"
export let overKeyAt: usmallint = 0;    // "PRESS ENTER TO TRY AGAIN"

// The strings themselves — the hints, the status line, the message — are
// ui/ScoreBar.web.8bx's and ui/GameOver.web.8bx's, beside the prints that
// use them. Nothing here erases the message: both lines sit in the 1-row
// gaps between tiles — the rows <Tile /> never touches — so the panel's
// trick of letting the tiles paint back over it would not have worked;
// main.8bs blanks the screen when the next game starts instead, which is
// the only way out of a finished game and clears every skin's message at
// once.

// ---- the copyright line ---------------------------------------------------
//
// The port's own line, on the second-to-last row so the version keeps the
// last one and the middle of the screen stays clear. The original game's
// author and repo are credited in README.md rather than here.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the glyphs poked in after: putChar writes a
// glyph and nothing else, and the print is what put the colour on those
// cells. The web host's font is indexed by ASCII outright, so these are the
// two ASCII codes.
let creditPortAt: usmallint = 0;
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

export function computeLayout(): void {
    rowWidth = text.columns();
    let rows: usmallint = text.rows();
    gridRows = rows;

    wide = rowWidth >= WIDE_MIN_COLUMNS;
    if (wide) {
        // The biggest tile whose 4 columns plus 3 gaps plus the side
        // margins fit rowWidth — rounded down to even for the block-digit
        // font's own centring rule (see the header comment) — and,
        // independently, whose 4 rows plus 3 gaps plus the top/bottom
        // margin fit rows. The two axes are unrelated here because WIDE's
        // HUD spends columns, not rows, so nothing forces tileW and
        // tileH to move together the way NARROW's square tile does.
        let wFit: usmallint = WIDE_TILE_MIN;
        if (rowWidth > WIDE_MARGIN_COLUMNS + 3) {
            wFit = (rowWidth - WIDE_MARGIN_COLUMNS - 3) >> 2;
        }
        if ((wFit & 1) == 1) {
            wFit = wFit - 1;
        }
        if (wFit < WIDE_TILE_MIN) {
            wFit = WIDE_TILE_MIN;
        } else if (wFit > WIDE_TILE_MAX) {
            wFit = WIDE_TILE_MAX;
        }
        let hFit: usmallint = WIDE_TILE_H_MIN;
        if (rows > WIDE_MARGIN_ROWS + 3) {
            hFit = (rows - WIDE_MARGIN_ROWS - 3) >> 2;
        }
        if (hFit < WIDE_TILE_H_MIN) {
            hFit = WIDE_TILE_H_MIN;
        } else if (hFit > WIDE_TILE_H_MAX) {
            hFit = WIDE_TILE_H_MAX;
        }
        tileW = wFit;
        tileH = hFit;
    } else {
        // The biggest SQUARE tile — a character cell is itself square,
        // CHAR_W == CHAR_H, but NOT forced square: WIDE's own tile isn't
        // (8×5), because the block-digit font wants width for four digits
        // and only height for three rows of glyph. A live grid this
        // arrangement is in almost always has less room on the row axis
        // than the column axis for the SAME reason WIDE doesn't need a
        // square tile either — the header/status stack's own overhead (4
        // text rows plus padding) eats into rows the way WIDE's side
        // margins eat into columns — so forcing tileW and tileH equal here
        // would cap both at whichever axis is tighter, the same "postage
        // stamp" tile a phone-portrait window needs but a near-square or
        // 4:3 one does not. tileW and tileH are worked out independently
        // instead, each against its own axis's own overhead, the same
        // move WIDE's own computeLayout() branch already makes.
        //
        // Both divisions reserve 2 more than the bare minimum (5, not 3,
        // for columns; 9, not 7, for rows) so the leftover after picking
        // the biggest tile that still divides evenly is *guaranteed* at
        // least 2 — not just non-negative. Without that, the leftover is
        // whatever (rowWidth - 3) mod 4 happens to be: 0 or 1 as often as
        // 2 or 3, which is what let the header sit flush against the top
        // of the screen at some window sizes and not others. Reserving 2
        // extra up front means the header/status split below (and the
        // equivalent boardLeft centring) always has at least 1 to give
        // each side, at the cost of a tile that is up to one cell smaller
        // than the bare-minimum arithmetic would otherwise allow.
        let wFit: usmallint = NARROW_TILE_MIN;
        if (rowWidth > 5) {
            wFit = (rowWidth - 5) >> 2;
        }
        let hFit: usmallint = NARROW_TILE_MIN;
        if (rows > 9) {
            hFit = (rows - 9) >> 2;
        }
        // Kept within 2x of each other before either is clamped to its own
        // floor/ceiling, so a genuine phone portrait — rows to spare,
        // columns tight — doesn't turn the tile into a tall obelisk just
        // because the row axis alone would allow it. 2x is roughly WIDE's
        // own 8:5 proportion; the direction that actually fires here is
        // Only tileH is capped against the other axis, at 1.5x rather than
        // 2x — a tile wider than it is tall (WIDE's own 8x5 is 1.6:1, and
        // an ultrawide WIDE tile goes well past that) reads as an
        // ordinary landscape tile, but one *taller* than it is wide reads
        // as a tall obelisk the moment it goes far past square, which is
        // what a genuine phone portrait's generous row budget would
        // otherwise produce with no cap at all. tileW carries no
        // matching cap: NARROW's row axis is almost always the tighter
        // one (the header/status stack costs rows the way WIDE's side
        // margins cost columns), so it is column room, not row room,
        // that should be spent on the tile when there is extra of it —
        // capping tileW here would throw that away as empty margin
        // instead of a bigger board.
        if (hFit > ((wFit * 3) >> 1)) {
            hFit = (wFit * 3) >> 1;
        }
        // Even, the same reason the WIDE tile is kept even (see "why the
        // HUD is in the margins" above): whenever this reaches
        // BLOCK_DIGIT_MIN below, Tile.web.8bx switches this arrangement to
        // the same block-digit font WIDE uses, and that font's centring
        // is only exact on an even width. tileH carries no such
        // requirement — the glyph rows centre under any height >= 3.
        if ((wFit & 1) == 1) {
            wFit = wFit - 1;
        }
        if (wFit < NARROW_TILE_MIN) {
            wFit = NARROW_TILE_MIN;
        } else if (wFit > NARROW_TILE_MAX) {
            wFit = NARROW_TILE_MAX;
        }
        if (hFit < NARROW_TILE_MIN) {
            hFit = NARROW_TILE_MIN;
        } else if (hFit > NARROW_TILE_MAX) {
            hFit = NARROW_TILE_MAX;
        }
        tileW = wFit;
        tileH = hFit;
    }
    boardWidth = 4 * tileW + 3;
    boardHeight = 4 * tileH + 3;

    // Centred when the live grid is bigger than the board's footprint,
    // flush to the edge (never negative — usmallint is unsigned) when the
    // host hands out a grid too small for it, the same guard tile.8bs's
    // own leftMargin skips only because every machine it runs on is
    // already known to fit.
    boardLeft = 0;
    if (rowWidth > boardWidth) {
        boardLeft = (rowWidth - boardWidth) >> 1;
    }

    if (wide) {
        boardTop = 0;
        if (rows > boardHeight) {
            boardTop = (rows - boardHeight) >> 1;
        }

        // One clear column past the board's right edge, where the HUD's
        // right half lives — the same "differ by a column" reasoning as
        // before (2048 is four characters, SCORE is five) still applies;
        // it is just computed from boardLeft/boardWidth now instead of
        // hand-picked.
        //
        // Clamped so the widest field anchored here (VERSION_LINE, 6
        // characters) never writes past the row's own right edge: at the
        // 48-column baseline rightAt + 6 lands exactly on 48 and this
        // never fires, but a narrower live grid shrinks boardLeft (and so
        // rightAt) only until the board no longer fits — past that point
        // rightAt stops shrinking while rowWidth keeps shrinking, and an
        // unclamped column would run off the row into the next one's
        // memory. Clamping trades that corruption for the right margin
        // overlapping the board on a grid too narrow for both. In
        // practice WIDE_MIN_COLUMNS already keeps this from firing — it
        // stays as a second, independent guard rather than a promise this
        // file only has to keep in one place.
        let rightAt: usmallint = boardLeft + boardWidth + 1;
        if (rightAt + RIGHT_HUD_WIDTH > rowWidth) {
            if (rowWidth > RIGHT_HUD_WIDTH) {
                rightAt = rowWidth - RIGHT_HUD_WIDTH;
            } else {
                rightAt = 0;
            }
        }

        titleNameAt = boardTop * rowWidth + 1;
        scoreLabelAt = boardTop * rowWidth + rightAt;
        scoreValueAt = (boardTop + 1) * rowWidth + rightAt;
        // Clamped the same way rightAt is, and for the same reason: these
        // two rows are boardHeight-relative (21 and 22 of the board's own
        // footprint), which only exist in the live grid when rows is at
        // least that tall. A grid shorter than the board's footprint —
        // reachable from web-layout.mjs's MIN_ROWS — pushes both onto the
        // last live row instead of past it.
        let hintTopRow: usmallint = boardTop + boardHeight - 2;
        if (hintTopRow >= rows) {
            hintTopRow = rows - 1;
        }
        let hintBottomRow: usmallint = boardTop + boardHeight - 1;
        if (hintBottomRow >= rows) {
            hintBottomRow = rows - 1;
        }
        hintTopAt = hintTopRow * rowWidth + rightAt;
        hintBottomAt = hintBottomRow * rowWidth + rightAt;
    } else {
        // tile.8bs's own shape: a header row, a blank row, the board, a
        // blank row, a status row — five rows of overhead around
        // boardHeight, centred on the live rows the same way tile.8bs
        // centres it on Video.ROWS. Guarded the same way boardLeft is:
        // a grid shorter than the full stack (reachable at MIN_ROWS,
        // which is one row short of it) gets header/board/status packed
        // from the top instead of the arithmetic underflowing.
        let totalHeight: usmallint = boardHeight + 4;
        let headerRow: usmallint = 0;
        if (rows > totalHeight) {
            headerRow = (rows - totalHeight) >> 1;
        }
        headerAt = headerRow * rowWidth;
        boardTop = headerRow + 2;
        let statusRow: usmallint = boardTop + boardHeight + 1;
        if (statusRow >= rows) {
            statusRow = rows - 1;
        }
        statusAt = statusRow * rowWidth + boardLeft;
    }

    titleAt = ((rows >> 1) - 1) * rowWidth + ((rowWidth - TITLE_LEN) >> 1);
    promptAt = ((rows >> 1) + 1) * rowWidth + ((rowWidth - PROMPT_LEN) >> 1);
    touchPromptAt = ((rows >> 1) + 1) * rowWidth + ((rowWidth - TOUCH_PROMPT_LEN) >> 1);
    let versionCol: usmallint = 0;
    if (rowWidth > RIGHT_HUD_WIDTH) {
        versionCol = rowWidth - RIGHT_HUD_WIDTH;
    }
    versionAt = (rows - 1) * rowWidth + versionCol;
    creditPortAt = (rows - 2) * rowWidth + ((rowWidth - CREDIT_PORT_LEN) >> 1);

    // The two gap rows the game-over message goes in: the row directly
    // above a tile row, which tileCell() already knows — the same trick
    // tile.8bs's own computeLayout() uses (see that file), so this is not
    // a second copy of the arithmetic, just the same move applied here.
    // tileCell()'s column term already carries boardLeft, so it comes back
    // off before the message centres on the full live rowWidth instead.
    overAt = tileCell(1, 0) - rowWidth - boardLeft + ((rowWidth - OVER_TITLE_LEN) >> 1);
    overTouchAt = tileCell(3, 0) - rowWidth - boardLeft + ((rowWidth - OVER_TOUCH_LEN) >> 1);
    overKeyAt = tileCell(3, 0) - rowWidth - boardLeft + ((rowWidth - OVER_KEY_LEN) >> 1);
    return;
}

// The screen cell a tile's top-left corner starts at — tile.8bs's own
// tileCell(), read from the live boardLeft/boardTop/rowWidth computeLayout()
// just worked out instead of a fixed ORIGIN table.
//
// y and x are each clamped to leave room for a full tileH-row/tileW-column
// block, the same way boardLeft/rightAt leave room for what they anchor:
// the board's footprint is fixed once tileW/tileH are chosen, and a live
// grid a little short of it (reachable at web-layout.mjs's MIN_ROWS/
// MIN_COLUMNS) would otherwise send a lower or righter tile's block past
// the last live row or column — off the end of the character region and
// into color RAM. Clamping to gridRows - tileH / rowWidth - tileW, not
// gridRows - 1 / rowWidth - 1, is what keeps the whole block in bounds,
// not just its top-left corner; it stacks or overlaps the outermost tiles
// instead of writing part of one past the grid.
export function tileCell(row: utinyint, col: utinyint): usmallint {
    let y: usmallint = boardTop + row * (tileH + 1);
    if (y + tileH > gridRows) {
        if (gridRows > tileH) {
            y = gridRows - tileH;
        } else {
            y = 0;
        }
    }
    let x: usmallint = boardLeft + col * (tileW + 1);
    if (x + tileW > rowWidth) {
        if (rowWidth > tileW) {
            x = rowWidth - tileW;
        } else {
            x = 0;
        }
    }
    return y * rowWidth + x;
}

export function drawTitleScreen(): void {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(titleAt, "2048");
    if (input.touch()) {
        text.print(touchPromptAt, "TOUCH TO START");
    } else {
        text.print(promptAt, "PRESS ENTER");
    }
    // The credit line is 19 columns centred on the full row, one row above
    // the version, which is flush to the right edge — on a WIDE row those
    // two land nowhere near each other, but a NARROW row is not wide
    // enough to keep them apart: the version would sit directly under the
    // credit line's own tail end. Dropping the credit line (never the
    // title, prompt, or version — all three earn their place) is the same
    // move the HUD makes elsewhere in this file: the lower-priority field
    // goes, not a cramped compromise of both.
    if (wide) {
        text.print(creditPortAt, " C  2026 8BITSCRIPT");
        text.putChar(creditPortAt, PAREN_OPEN);
        text.putChar(creditPortAt + 2, PAREN_CLOSE);
    }
    text.print(versionAt, VERSION_LINE);
    return;
}



export function fillTile(origin: usmallint, exponent: utinyint): void {
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    let rowCell: usmallint = origin;
    let line: usmallint = 0;
    while (line < tileH) {
        text.fill(rowCell, tileW, 32);
        rowCell = rowCell + rowWidth;
        line++;
    }
    return;
}

// The WIDE arrangement's digit: two block-digit glyphs per character,
// three rows tall.
export function drawDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        text.putChar(rowCell, DIGIT_TILES[base]);
        text.putChar(rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + rowWidth;
        row++;
    }
    return;
}


// The title wobble is tile.8bs's — the portable skin, read by the one
// 6502 machine with a per-scanline hook (the C64). The web answers
// #fact(video.raster) true too, but this skin draws its own title and
// does not take the effect up yet; an empty function here means the
// compiler deletes the call, and the game's raster.disable() at start is
// a no-op against a list that was never built.
export function wobbleTitle(): void {
    return;
}

// Whether this frame's tile is wide enough for the block-digit font —
// ui/Tile.web.8bx's one question. A function rather than an exported
// BLOCK_DIGIT_MIN because an imported scalar const does not survive the
// linker today (8bitscript: "no type on this IR node"); one compare, and
// it inlines.
export function blockDigitsFit(): bool {
    return tileW >= BLOCK_DIGIT_MIN;
}
