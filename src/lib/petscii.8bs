// The PET's own screen: where everything goes on its 40 or 80 columns,
// and how it is written — screen codes straight into video RAM at $8000,
// a solid block of quadrant-block pseudo-pixels for a tile with the value
// cut into it in inverted block-digits (lib/font.pet.8bs), and every line
// of text as a run of pre-converted codes. Not a twin: the elements in
// ui/ reach this from their `#system() == System.PET` arm, and on the
// other eight machines that arm folds away and nothing here is linked —
// a twin's names cannot be imported from a machine that has no twin, and
// a dead arm that names one is still a link error.
//
// Why the PET needs a different tile at all: text.printNumber's centring
// (see layout.8bs) is exact only when cellWidth - digitWidth is even, and a
// 1-character-wide digit makes that parity flip between 1-, 2-, 3- and
// 4-digit tiles — there is no cellWidth that centres all four. A PET
// quadrant-block digit is 2 cells wide, so the same leftover is always
// even, and every digit count from "2" to "2048" centres exactly. That
// gain is PET-only: it is the one target with a fixed-glyph ROM whose
// quadrant-block characters (see packages/pet/AGENTS.md) turn into a
// font at all; no portable `blocks` capability exists to draw the same
// thing on the other eight.
//
// The font here is the inverted form of @8bitscript/pet/blocks's own
// DIGIT_TILES (bit 7 flipped): drawn over a solid reverse-video tile,
// that is dark ink cut into the tile rather than a fresh glyph punching
// a black rectangle through it. Kept as data in this file so the game
// never links digits.print / printCentered / patternIndex — 2048 only
// ever stamps the eleven face values below.
//
// The HUD is the same idea one layer up. text.print / printNumber /
// asciiToScreenCode are a portable conversion pipeline this file does
// not need: every PET's graphics set puts A–Z at screen codes 1–26
// (both character ROMs; packages/pet/AGENTS.md), digits and space sit
// at their ASCII values, and the VIA PCR ($E84C) is one store. A loop
// over baked codes is smaller than linking the converter, and it is
// what lets a stock 4K 2001's ~3K of usable RAM hold the game.
import { Video } from "@8bitscript/system";
import { DIGIT_TILES } from "./font.8bs";

const ROW: usmallint = Video.COLUMNS; // 40, or 80 on an 8032 build

const TILE_H: utinyint = 5;

// Screen code 160 is all four quadrants on — the same reverse-space a
// filled tile is. Written directly so fillSquare is a store, not a call
// into text.print (five prints of eight spaces cost more than this loop).
const SOLID: utinyint = 160;

// VIA PCR: $0C selects the graphics character set. A–Z are then screen
// codes 1–26 on every PET, including the 2001's swapped text ROM, so
// the HUD table below is one table rather than two.
const GRAPHICS_SET: utinyint = 0x0C;
const VIA_PCR: usmallint = 0xE84C;
const SCREEN: usmallint = 0x8000;



// Graphics-set screen codes for the HUD, the game-over message and the
// title screen. Header is 12, each status line is 19 (the longest of them,
// padded so a shorter one never leaves a leftover glyph), then GAME OVER
// (9), the retry prompt (25) — whose own first twelve codes are the title
// screen's PRESS RETURN, rather than a second copy of them — the port's
// copyright line, and the version; keep those last six bytes in sync with
// package.json "version". A status line is 14 rather than 19 now that
// GAME OVER - RESTART no longer lives among them. Writing screen codes
// direct is also why "(C)" needs no special handling here: 40 and 41 are
// "(" and ")" in the graphics set like any other code.
// A=1 … Z=26, digits and space unchanged. ASCII 'v' (118) is a graphics
// block in this set (codes 96-127); the version prefix is V, same as the
// rest of the HUD. The PET has a keyboard and no joystick ports, so this
// table never carries FIRE/START/ENTER variants.
const HUD: array<utinyint, 99> = [
    50, 48, 52, 56, 32, 32, 19, 3, 15, 18, 5, 32,  // "2048  SCORE " (12)
    1, 18, 18, 15, 23, 19, 32, 20, 15, 32, 13, 15, 22, 5,  // "ARROWS TO MOVE" (14)
    25, 15, 21, 32, 13, 1, 4, 5, 32, 50, 48, 52, 56, 32,  // "YOU MADE 2048 " (14)
    7, 1, 13, 5, 32, 15, 22, 5, 18,  // "GAME OVER" (9)
    16, 18, 5, 19, 19, 32, 18, 5, 20, 21, 18, 14, 32, 20, 15, 32, 20, 18, 25, 32, 1, 7, 1, 9, 14,  // "PRESS RETURN TO TRY AGAIN" (25)
    40, 3, 41, 32, 50, 48, 50, 54, 32, 56, 2, 9, 20, 19, 3, 18, 9, 16, 20,  // "(C) 2026 8BITSCRIPT" (19)
    22, 48, 46, 49, 46, 52,  // "V0.1.4" (6) — V is screen code 22, not ASCII 118
];
// Where each run of codes starts in HUD, and how long it is. A namespace
// so the elements' PET arms can import them: an imported bare
// number const does not survive the linker today, a namespace member does.
export namespace hud {
    const ARROWS: utinyint = 12;
    const WON: utinyint = 26;
    const OVER_TITLE: utinyint = 40;
    const OVER_TITLE_LEN: utinyint = 9;
    const OVER_PROMPT: utinyint = 49;
    const OVER_PROMPT_LEN: utinyint = 25;
    const COPYRIGHT: utinyint = 74;
    const COPYRIGHT_LEN: utinyint = 19;
    const TITLE_AT: utinyint = 0;
    const TITLE_LEN: utinyint = 4;
    const SCORE_LABEL_AT: utinyint = 6;
    const SCORE_LABEL_LEN: utinyint = 6;
    const STATUS_LEN: utinyint = 14;
    const SCORE_DIGITS_LEN: utinyint = 5;
    const TITLE_PRESS_RETURN: utinyint = 49; // the prompt's own first twelve codes
    const TITLE_PRESS_RETURN_LEN: utinyint = 12;
    const TITLE_VERSION: utinyint = 93;
    const TITLE_VERSION_LEN: utinyint = 6;
}

// ---- where the game-over message goes -------------------------------------
//
// "GAME OVER" in the blank row between the first and second rows of tiles
// (row 6), the retry prompt in the row between the third and fourth (row
// 18), instead of one line under the board. Both rows are already empty —
// <Tile /> never touches a gap row — so the message costs the board
// nothing and leaves the position the player just lost on in full view.
// Each line is centred on the screen: (columns - length) / 2. Cells are
// written out per width the same way the header and status rows are, so
// the unused arm folds away on a 40- or 80-column build.
//
// Nothing erases them: main.8bs blanks the screen when the next game
// starts, which is the only way out of a finished game.
// The port's own copyright line, on the second-to-last row so the version
// keeps the last one. The original game's author and repo are credited in
// README.md rather than on screen.
export namespace at {
    const COPYRIGHT_40: usmallint = 930;  // row 23, col 10
    const COPYRIGHT_80: usmallint = 1870; // row 23, col 30
    const OVER_TITLE_40: usmallint = 255;   // row 6, col 15
    const OVER_PROMPT_40: usmallint = 727;  // row 18, col 7
    const OVER_TITLE_80: usmallint = 515;   // row 6, col 35
    const OVER_PROMPT_80: usmallint = 1467; // row 18, col 27
}

const SCORE_PLACES: array<usmallint, 5> = [10000, 1000, 100, 10, 1];

// Top-left cell of each board square. Compile-time data: (1 + row×6)×
// columns + leftMargin + col×9. The unused table is pruned, and an index
// is smaller than the 16-bit multiply that would recompute it.
export const ORIGIN_40: array<usmallint, 16> = [
    42, 51, 60, 69,
    282, 291, 300, 309,
    522, 531, 540, 549,
    762, 771, 780, 789,
];
export const ORIGIN_80: array<usmallint, 16> = [
    102, 111, 120, 129,
    582, 591, 600, 609,
    1062, 1071, 1080, 1089,
    1542, 1551, 1560, 1569,
];

export function writeCells(cell: usmallint, base: utinyint, count: utinyint): void {
    let i: utinyint = 0;
    while (i < count) {
        memory.write(SCREEN + cell + i, HUD[base + i]);
        i++;
    }
    return;
}

// The one run of spaces this file needs — the status line, when the board
// has taken over announcing the end of the game — as a loop rather than 19
// bytes of 32s in HUD: space is a screen code like any other, so nothing
// has to be looked up to write it.
export function blankCells(cell: usmallint, count: utinyint): void {
    let i: utinyint = 0;
    while (i < count) {
        memory.write(SCREEN + cell + i, 32);
        i++;
    }
    return;
}

export function printScore5(cell: usmallint, value: usmallint): void {
    let i: utinyint = 0;
    while (i < 5) {
        let digit: utinyint = 48;
        while (value >= SCORE_PLACES[i]) {
            value = value - SCORE_PLACES[i];
            digit++;
        }
        memory.write(SCREEN + cell + i, digit);
        i++;
    }
    return;
}

// The PET has two character sets and the HUD is baked for the graphics
// one (V is screen code 22 there); the VIA's PCR bit picks it. Every
// element that writes text calls this first.
export function graphicsSet(): void {
    memory.write(VIA_PCR, GRAPHICS_SET);
}



export function fillSquare(origin: usmallint): void {
    let rowCell: usmallint = origin;
    let row: utinyint = 0;
    while (row < TILE_H) {
        let col: utinyint = 0;
        while (col < 8) {
            memory.write(SCREEN + rowCell + col, SOLID);
            col++;
        }
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}

export function stampDigit(cell: usmallint, value: utinyint): void {
    let base: utinyint = value * 6;
    let rowCell: usmallint = cell;
    let row: utinyint = 0;
    while (row < 3) {
        memory.write(SCREEN + rowCell, DIGIT_TILES[base]);
        memory.write(SCREEN + rowCell + 1, DIGIT_TILES[base + 1]);
        base = base + 2;
        rowCell = rowCell + ROW;
        row++;
    }
    return;
}


// The tile itself is ui/Tile.8bx's PET arm: fillSquare() and stampDigit()
// above, the ORIGIN tables and lib/font.pet.8bs are what it is made of.

// No PET has a raster; the title screen never takes the wobble.
