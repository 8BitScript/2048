// The PET's tile: an 8x5 solid square of screen codes written straight
// into video RAM, and the value as 2x3 block digits stamped right-aligned
// on its second row — lib/tile.pet.8bs's fillTile() and drawDigit(), its
// ORIGIN tables (compile-time data: an index is smaller than the 16-bit
// multiply that would recompute it) and its TILE_DIGIT font. This twin
// exists because the PET paints nothing through @8bitscript/text, and the
// 4K 2001 build is the reason: 2763 bytes, the same as the drawTile() it
// replaced.
import { Video } from "@8bitscript/system";
import { fillTile, drawDigit, ORIGIN_40, ORIGIN_80, TILE_DIGIT_AT, TILE_DIGIT } from "../lib/tile.8bs";

const ROW: usmallint = Video.COLUMNS; // 40, or 80 on an 8032 build

export component Tile(row: utinyint, col: utinyint, exponent: utinyint) {
    let cell: utinyint = row * 4 + col;
    let origin: usmallint = ORIGIN_40[cell];
    if (Video.COLUMNS != 40) {
        origin = ORIGIN_80[cell];
    }
    fillTile(origin);
    let base: utinyint = TILE_DIGIT_AT[exponent];
    let count: utinyint = TILE_DIGIT_AT[exponent + 1] - base;
    if (count != 0) {
        let at: usmallint = origin + ROW + (4 - count);
        let i: utinyint = 0;
        while (i < count) {
            drawDigit(at, TILE_DIGIT[base + i]);
            at = at + 2;
            i++;
        }
    }
}
