// GAME OVER in the gap row between the first and second rows of tiles, the
// retry prompt in the one between the third and fourth — each centred for
// the build's width, from lib/layout.pet.8bs's baked codes. Nothing erases
// them: 2048.8bs blanks the screen when the next game starts.
import { Video } from "@8bitscript/system";
import { writeCells, hud, at } from "../lib/layout.8bs";

export component GameOver() {
    let overTitleAt: usmallint = at.OVER_TITLE_40;
    let overPromptAt: usmallint = at.OVER_PROMPT_40;
    if (Video.COLUMNS != 40) {
        overTitleAt = at.OVER_TITLE_80;
        overPromptAt = at.OVER_PROMPT_80;
    }
    writeCells(overTitleAt, hud.OVER_TITLE, hud.OVER_TITLE_LEN);
    writeCells(overPromptAt, hud.OVER_PROMPT, hud.OVER_PROMPT_LEN);
}
