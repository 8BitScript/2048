// The web's fixed vic20 skin: a header row and a status row at the
// skin's own cells. Identical on the three fixed skins; a twin each
// because the resolver would otherwise hand them the fluid host's
// ScoreBar.web.8bx. All three go when the fixed skins fold into the
// fluid layout.
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";
import { at } from "../lib/tile.8bs";

const SCORE_HEADER_LEN: utinyint = 11; // "SCORE " plus a five-digit score field
// One blank as wide as the longest status line: the status line is the
// only thing this skin erases — the game-over lines are cleared by the
// next game's blank.
const STATUS_BLANK: string = "                   "; // 19 spaces

export component ScoreBar(score: usmallint, over: bool, won: bool) {
    text.setReverse(false);
    text.setColor(TextColor.WHITE);
    text.print(at.HEADER, "2048");
    text.print(text.COLUMNS - SCORE_HEADER_LEN, `SCORE ${score:5}`);
    // Always write the status line, never just leave it: the branch that
    // printed nothing is what used to strand a message across a restart on
    // a touch host, where ARROWS TO MOVE is suppressed.
    if (won) {
        text.print(at.STATUS, "YOU MADE 2048      ");
    } else if (!over && !input.touch()) {
        text.print(at.STATUS, "ARROWS TO MOVE     ");
    } else {
        text.print(at.STATUS, STATUS_BLANK);
    }
}
