// The port's own line, up from the first frame until the first move that
// changes the board, when lib/text/copyright.8bs sweeps it away. On every
// skin but the PET and the VIC-20 it is centred on the second-to-last row,
// so the version keeps the last one. On the VIC-20 it holds the one footer
// row alone, from the board's left edge to its right, until the sweep
// hands the row to the status line and the version. On the PET the 8×5 board already uses every other
// row, so the line sits on the header between the name and the score
// (COPYRIGHT_ON_HEADER). The original game's author and repo are credited
// in README.md rather than on screen.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the two glyphs poked in after — putChar
// writes a glyph and nothing else, and the print is what put the colour on
// those cells. Every machine's putChar takes the character in ASCII (the
// web host's font is ASCII-indexed outright), so 40 and 41 are the same two
// numbers everywhere.
//
// Everywhere except the NES, whose font draws both as blank tiles
// (packages/nes/native/6502/font.s: "$22-$2B ... 10 blank tiles"), so it
// spells COPYRIGHT out instead. #system() folds, so each image carries one
// of the two. The placeholder is a space rather than a marker character for
// the same reason: if a machine ever did drop the poke, the line degrades
// to "C 2026 8BITSCRIPT" rather than showing punctuation nobody meant.
import { text } from "@8bitscript/text";
import { System } from "@8bitscript/system";
import { Copyright as Copy } from "@8bitscript/i18n/catalog";
import { copyrightAt, copyrightFits } from "@lib/text/copyright.8bs";

const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

// Where the line goes is lib/text/copyright.8bs's, shared with the sweep
// that takes it down after the first move; whether it is still up is
// ui/Screen.8bx's test, so this element only ever prints. On a fixed grid
// copyrightAt() folds to one literal; on the PET's header and the fluid
// host it is a short computation, kept in one local.
export component Copyright() {
    if (copyrightFits()) {
        let at: usmallint = copyrightAt();
        if (#system() == System.NES) {
            text.print(at, Copy.WORD);
        } else {
            text.print(at, Copy.LINE);
            text.putChar(at, PAREN_OPEN);
            text.putChar(at + 2, PAREN_CLOSE);
        }
    }
}
