// The port's own line, centred on the second-to-last row so the version
// keeps the last one and the middle of the screen stays clear. The
// original game's author and repo are credited in README.md rather than
// on screen. The PET writes it as nineteen screen codes (lib/petscii.8bs)
// on row 23 — "(" and ")" are codes 40 and 41 in its graphics set like
// any other, so it needs none of the poking below.
//
// "(" and ")" are not in the portable character set, so the line is printed
// with spaces where they go and the two glyphs poked in after — putChar
// writes a glyph and nothing else, and the print is what put the colour on
// those cells. Every machine's putChar takes the character in ASCII (the
// web host's font is ASCII-indexed outright), so 40 and 41 are the same two
// numbers everywhere.
//
// Everywhere except the NES, whose font draws both as blank tiles
// (packages/nes/native/6502/font.s: "$22-$2B ... 10 blank tiles"), so it
// spells COPYRIGHT out instead. #system() folds, so each image carries one
// of the two. The placeholder is a space rather than a marker character for
// the same reason: if a machine ever did drop the poke, the line degrades
// to "C 2026 8BITSCRIPT" rather than showing punctuation nobody meant.
//
// On the fluid web host a NARROW window is not wide enough to keep this
// line and the version apart — the version would sit under its tail —
// so the lower-priority line goes, the same move the score bar makes,
// rather than a cramped compromise of both.
import { text } from "@8bitscript/text";
import { screen } from "@8bitscript/screen";
import { System, Video } from "@8bitscript/system";
import { wide } from "../lib/layout.8bs";
import { COPYRIGHT, COPYRIGHT_WORD } from "../lib/strings.8bs";
import { writeCells } from "../lib/petscii.8bs";
import { hud, at } from "../lib/codes.8bs";

const FLUID: bool = screen.RESIZABLE;
const ROW: usmallint = text.COLUMNS;
const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

// On a fixed grid the address is a compile-time constant and is written
// out at each of the three uses rather than hoisted into a local: a local
// is a variable to the folder, and the add it saves in the source costs a
// 16-bit add and a slot in the image (+35 bytes on the VIC-20).
export component Copyright() {
    if (#system() == System.PET) {
        let cell: usmallint = at.COPYRIGHT_40;
        if (Video.COLUMNS != 40) {
            cell = at.COPYRIGHT_80;
        }
        writeCells(cell, hud.COPYRIGHT, hud.COPYRIGHT_LEN);
    } else if (FLUID) {
        if (wide) {
            let cols: usmallint = text.columns();
            let rows: usmallint = text.rows();
            let at: usmallint = (rows - 2) * cols + ((cols - COPYRIGHT.length) >> 1);
            text.print(at, COPYRIGHT);
            text.putChar(at, PAREN_OPEN);
            text.putChar(at + 2, PAREN_CLOSE);
        }
    } else if (#system() == System.NES) {
        text.print((Video.ROWS - 2) * ROW + ((text.COLUMNS - COPYRIGHT_WORD.length) >> 1), COPYRIGHT_WORD);
    } else {
        text.print((Video.ROWS - 2) * ROW + ((text.COLUMNS - COPYRIGHT.length) >> 1), COPYRIGHT);
        text.putChar((Video.ROWS - 2) * ROW + ((text.COLUMNS - COPYRIGHT.length) >> 1), PAREN_OPEN);
        text.putChar((Video.ROWS - 2) * ROW + ((text.COLUMNS - COPYRIGHT.length) >> 1) + 2, PAREN_CLOSE);
    }
}
