// The credit line, 19 columns centred on the full row, one row above the
// version — on a WIDE row those two land nowhere near each other, but a
// NARROW row is not wide enough to keep them apart: the version would sit
// directly under the credit line's own tail end. Dropping the credit line
// (never the title, prompt, or version — all three earn their place) is
// the same move the score bar makes: the lower-priority field goes, not a
// cramped compromise of both. The fixed skins are always wide.
//
// "(" and ")" are printed as spaces and the glyphs poked in after — the
// web host's font is indexed by ASCII outright, so these are the two ASCII
// codes.
import { text } from "@8bitscript/text";
import { wide, creditPortAt } from "../lib/tile.8bs";

const PAREN_OPEN: utinyint = 40;
const PAREN_CLOSE: utinyint = 41;

export component Copyright() {
    if (wide) {
        text.print(creditPortAt, " C  2026 8BITSCRIPT");
        text.putChar(creditPortAt, PAREN_OPEN);
        text.putChar(creditPortAt + 2, PAREN_CLOSE);
    }
}
