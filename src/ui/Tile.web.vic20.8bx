// The web's fixed VIC-20 skin uses the portable tile, Tile.8bx — but the
// resolver's twin order for a web build with machine=vic20 is
// Tile.web.vic20.8bx, then Tile.web.8bx (the fluid host's, which paints
// differently), then Tile.8bx, so without this file the fixed skin would
// get the fluid tile. This is Tile.8bx's body, verbatim; it goes when the
// fixed web skins fold into the fluid host's layout.
import { text } from "@8bitscript/text";
import { tileCell, cellWidth, tileH, POW2, TILE_COLOR, TILE_DIGITS } from "../lib/tile.8bs";

// This machine's row width, so cell = y * ROW + x. Declared here rather
// than imported: an imported scalar const does not survive the linker
// today (8bitscript: "no type on this IR node"), and this one folds either
// way.
const ROW: usmallint = text.COLUMNS;

// Every tile — empty or not — is a filled cellWidth x tileH block of
// reverse video: `text.setReverse(true)` turns a printed space into a
// solid block in the current colour on all nine targets (a plain inverted
// block, no colour, on the three with none), so the same three calls draw
// a coloured square on a C64 and a monochrome one on a PET. `text.fill`
// writes `cellWidth` spaces — computeLayout() picked the width — so the
// same call fills the tile on a five-wide machine, the VIC-20's four, or
// the X16's twelve. The middle row's fill doubles as the field
// `printNumber` then centres digits into (an odd leftover space, when
// cellWidth - width is odd, falls to the right — `>> 1` truncates, never
// rounds up); the top and bottom rows are blank on purpose — they are the
// rest of the square, not wasted space.
export component Tile(row: utinyint, col: utinyint, exponent: utinyint) {
    let origin: usmallint = tileCell(row, col);
    let value: usmallint = POW2[exponent];
    text.setColor(TILE_COLOR[exponent]);
    text.setReverse(true);
    // A row cursor rather than origin + line * ROW: the backend inlines a
    // 16-bit multiply at every site, and this one is inside a loop.
    let rowCell: usmallint = origin;
    let numRow: usmallint = origin;
    let mid: utinyint = tileH >> 1;
    let line: utinyint = 0;
    while (line < tileH) {
        text.fill(rowCell, cellWidth, 32);
        if (line == mid) {
            numRow = rowCell; // the row the digits go in, kept as the cursor
                              // passes it rather than multiplied for again
        }
        rowCell = rowCell + ROW;
        line++;
    }
    if (value != 0) {
        let width: utinyint = TILE_DIGITS[exponent];
        let offset: utinyint = (cellWidth - width) >> 1;
        text.printNumber(numRow + offset, value, width);
    }
    text.setReverse(false); // so the next print — this frame's or the next — is not inverted
}
