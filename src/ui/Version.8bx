// The version: on the footer, ending on the board's right edge, once the
// copyright has left the row; on the PET, flush right on the last row (to
// the board's edge, HEADER_INSET). A "v" and then package.json's number.
// The row is the status line's too; the status text starts at the board's
// left and does not reach this field.
import { text } from "@8bitscript/text";
import { Video } from "@8bitscript/system";
import { VERSION } from "@lib/text/version.8bs";
import { COPYRIGHT_ON_HEADER, HEADER_INSET, boardWidth, statusAt } from "@lib/layout/layout.8bs";
import { footerFree } from "@lib/text/copyright.8bs";

const ROW: usmallint = text.COLUMNS;

export component Version() {
    if (COPYRIGHT_ON_HEADER) {
        let cell: usmallint = (Video.ROWS - 1) * ROW + text.COLUMNS - HEADER_INSET - VERSION.length - 1;
        text.print(cell, "v");
        text.print(cell + 1, VERSION);
    } else if (footerFree()) {
        // The footer: ending on the board's right edge, once the copyright
        // has given the row up (lib/text/copyright.8bs).
        let cell: usmallint = statusAt + boardWidth - VERSION.length - 1;
        text.print(cell, "v");
        text.print(cell + 1, VERSION);
    }
}
