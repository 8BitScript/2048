// The version, flush right on the last row. On the PET it is six screen
// codes out of lib/petscii.8bs's table (V is 22 there, not ASCII 118),
// on row 24 for the build's width.
import { text } from "@8bitscript/text";
import { screen } from "@8bitscript/screen";
import { System, Video } from "@8bitscript/system";
import { VERSION_LINE } from "../lib/version.8bs";
import { writeCells } from "../lib/petscii.8bs";
import { hud, at } from "../lib/codes.8bs";

const FLUID: bool = screen.RESIZABLE;
const ROW: usmallint = text.COLUMNS;
const VERSION_LEN: utinyint = 6; // "v0.2.0"

export component Version() {
    if (#system() == System.PET) {
        let cell: usmallint = at.VERSION_40;
        if (Video.COLUMNS != 40) {
            cell = at.VERSION_80;
        }
        writeCells(cell, hud.TITLE_VERSION, hud.TITLE_VERSION_LEN);
    } else if (FLUID) {
        let cols: usmallint = text.columns();
        let rows: usmallint = text.rows();
        text.print((rows - 1) * cols + cols - VERSION_LEN, VERSION_LINE);
    } else {
        text.print((Video.ROWS - 1) * ROW + text.COLUMNS - VERSION_LEN, VERSION_LINE);
    }
}
