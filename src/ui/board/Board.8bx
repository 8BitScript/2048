// The board as the player sees it: the score bar, the end of the game if
// it has come, then the tiles. The score bar comes first so the score a
// merge just banked appears with the board that earned it; the message
// before the tiles so it is printed in the score bar's colour, not the
// last tile's.
import { score, over, won } from "@lib/game/rules.8bs";
import { Tiles } from "./Tiles.8bx";
import { ScoreBar } from "./ScoreBar.8bx";
import { GameOver } from "./GameOver.8bx";

export component Board() {
    return (
        <>
            <ScoreBar score={score} over={over} won={won} />
            {over && <GameOver />}
            <Tiles />
        </>
    );
}
