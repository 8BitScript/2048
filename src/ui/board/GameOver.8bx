// GAME OVER, and how to try again, in the two gap rows inside the board —
// the rows <Tile /> never touches — so the position the player lost on
// stays in full view. The prompt names this machine's confirm control:
// RETURN on a keyboard (without the PRESS on a screen too narrow for it),
// START on a pad, FIRE on a stick, ENTER or a touch in a browser. Each is
// a compile-time fact but the touch, so one print survives per build.
//
// Nothing here erases these lines: 2048.8bs blanks the screen when the
// next game starts, which is the only way out of a finished game. On the
// fluid web host the border turns red too — two lines inside the board
// are a quiet thing to say, and the border is the rest of the screen
// saying it.
import { screen, BorderColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { Input, System } from "@8bitscript/system";
import { overAt, overPromptAt, overTouchAt, board, ENTER_KEY } from "../../lib/layout/layout.8bs";
import { GAME_OVER, RETURN_TO_TRY_AGAIN, RETURN_TO_TRY_AGAIN_NARROW, START_TO_TRY_AGAIN, FIRE_TO_TRY_AGAIN, ENTER_TO_TRY_AGAIN, ENTER_TO_TRY_AGAIN_NARROW, TOUCH_TO_TRY_AGAIN } from "../../lib/text/strings.8bs";
import { host } from "../../lib/host/host.8bs";

const FLUID: bool = screen.RESIZABLE;

export component GameOver() {
    if (FLUID) {
        screen.setBorder(BorderColor.RED);
        text.setReverse(false);
        text.setColor(TextColor.WHITE);
    }
    text.print(overAt, GAME_OVER);
    if (#system() == System.WEB) {
        if (host.touch()) {
            text.print(overTouchAt, TOUCH_TO_TRY_AGAIN);
        } else if (!FLUID && text.COLUMNS < board.FULL_WIDTH) {
            text.print(overPromptAt, ENTER_TO_TRY_AGAIN_NARROW);
        } else if (ENTER_KEY) {
            text.print(overPromptAt, ENTER_TO_TRY_AGAIN);
        } else {
            text.print(overPromptAt, RETURN_TO_TRY_AGAIN);
        }
    } else if (Input.KEYBOARD) {
        if (text.COLUMNS < board.FULL_WIDTH) {
            text.print(overPromptAt, RETURN_TO_TRY_AGAIN_NARROW);
        } else {
            text.print(overPromptAt, RETURN_TO_TRY_AGAIN);
        }
    } else if (Input.PADS > 0) {
        text.print(overPromptAt, START_TO_TRY_AGAIN);
    } else {
        text.print(overPromptAt, FIRE_TO_TRY_AGAIN);
    }
}
