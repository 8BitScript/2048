// The port's own line on row 23 — the version keeps the last one. The
// original game's author and repo are credited in README.md.
import { Video } from "@8bitscript/system";
import { writeCells, hud, at } from "../lib/layout.8bs";

export component Copyright() {
    let portAt: usmallint = at.COPYRIGHT_40;
    if (Video.COLUMNS != 40) {
        portAt = at.COPYRIGHT_80;
    }
    writeCells(portAt, hud.COPYRIGHT, hud.COPYRIGHT_LEN);
}
