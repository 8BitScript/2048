// The board: the sixteen tiles, and nothing around them. Only the cells
// whose exponent changed since they were last stamped are drawn. Sixteen
// filled squares with a background-coloured gap between them already read
// as one board; redrawing a tile that did not move blanks it first and
// that is the blink. The animated move repaints with this alone, between
// steps (play.8bs's animateMove); the settled frame takes the rest of the
// screen too (<Screen />). One function for both, which is why every
// build that animates is 60 bytes smaller than the hand-written program
// that kept a second copy of this loop.
import { board, shown } from "@lib/game/rules.8bs";
import { Tile } from "./Tile.8bx";

export component Board() {
    for (let i: utinyint = 0; i < 16; i++) {
        if (board[i] != shown[i]) {
            <Tile row={i >> 2} col={i & 3} exponent={board[i]} />;
            shown[i] = board[i];
        }
    }
}
