// How to start, one row below the middle of the screen, in the words of
// this machine's controls.
//
// On the machines the control is a compile-time fact (Input.*), so
// unused strings never reach the image. A stick or pad cannot be probed
// the way a 1351 can (`mouse.present()`): an idle CIA/PIA port reads the
// same with nothing plugged in as with a stick at rest. So a keyboard
// machine that *has* joystick or pad ports always names both confirm
// inputs; FIRE or START alone is only for a build with no keyboard (the
// NES). The web asks the host once whether it is a touchscreen
// (lib/host/host.web.8bs) and names the key otherwise — its own word for it,
// lib/layout/layout.8bs's ENTER_KEY, ENTER on a PC and RETURN on the PET replica.
import { text } from "@8bitscript/text";
import { screen } from "@8bitscript/screen";
import { Input, System, Video } from "@8bitscript/system";
import { Input as Controls } from "@8bitscript/input";
import { i18n } from "@8bitscript/i18n";
import { Prompt } from "@8bitscript/i18n/catalog";
import { ENTER_KEY } from "../../lib/layout/layout.8bs";
import { host } from "../../lib/host/host.8bs";

const FLUID: bool = screen.RESIZABLE;
const ROW: usmallint = text.COLUMNS;

// Every address below is a compile-time constant on a fixed grid, and is
// written out in full at each print rather than hoisted into a local: a
// local is a variable to the folder, and the add it saves in the source
// costs a 16-bit add and a slot in the image (+35 bytes on the VIC-20).
// The fluid host asks the live grid instead.
export component StartMessage() {
    if (FLUID) {
        let cols: usmallint = text.columns();
        let rows: usmallint = text.rows();
        if (host.touch()) {
            text.print(((rows >> 1) + 1) * cols + ((cols - Prompt.TOUCH_START.length) >> 1), Prompt.TOUCH_START);
        } else {
            text.print(((rows >> 1) + 1) * cols + ((cols - i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }));
        }
    } else if (#system() == System.WEB) {
        if (host.touch()) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - Prompt.TOUCH_START.length) >> 1), Prompt.TOUCH_START);
        } else if (ENTER_KEY) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }));
        } else {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START, { control: "RETURN" }).length) >> 1), i18n.format(Prompt.START, { control: "RETURN" }));
        }
    } else if (Input.PADS > 0) {
        if (Input.KEYBOARD) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START_EITHER, { control: Controls.CONFIRM_LABEL, other: Controls.ALT_CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START_EITHER, { control: Controls.CONFIRM_LABEL, other: Controls.ALT_CONFIRM_LABEL }));
        } else {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }));
        }
    } else if (Input.JOYSTICKS > 0) {
        if (Input.KEYBOARD) {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START_EITHER, { control: Controls.CONFIRM_LABEL, other: Controls.ALT_CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START_EITHER, { control: Controls.CONFIRM_LABEL, other: Controls.ALT_CONFIRM_LABEL }));
        } else {
            text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }));
        }
    } else {
        text.print(((Video.ROWS >> 1) + 1) * ROW + ((text.COLUMNS - i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }).length) >> 1), i18n.format(Prompt.START, { control: Controls.CONFIRM_LABEL }));
    }
}
