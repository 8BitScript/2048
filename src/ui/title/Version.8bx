// The version, flush right on the last row: a "v" and then package.json's
// number, on the last row for the build's width.
import { text } from "@8bitscript/text";
import { screen } from "@8bitscript/screen";
import { Video } from "@8bitscript/system";
import { VERSION } from "@lib/text/version.8bs";

const FLUID: bool = screen.RESIZABLE;
const ROW: usmallint = text.COLUMNS;

export component Version() {
    if (FLUID) {
        let cols: usmallint = text.columns();
        let rows: usmallint = text.rows();
        let cell: usmallint = (rows - 1) * cols + cols - VERSION.length - 1;
        text.print(cell, "v");
        text.print(cell + 1, VERSION);
    } else {
        let cell: usmallint = (Video.ROWS - 1) * ROW + text.COLUMNS - VERSION.length - 1;
        text.print(cell, "v");
        text.print(cell + 1, VERSION);
    }
}
