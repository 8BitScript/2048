// PRESS RETURN on row 13 — the prompt's own first twelve codes.
import { Video } from "@8bitscript/system";
import { writeCells, hud } from "../lib/layout.8bs";

export component StartMessage() {
    let promptAt: usmallint = 534;
    if (Video.COLUMNS != 40) {
        promptAt = 1074;
    }
    writeCells(promptAt, hud.TITLE_PRESS_RETURN, hud.TITLE_PRESS_RETURN_LEN);
}
