// One tile of the board: a filled square in the tile's colour, its value
// on the middle row. How that is painted is the machine's — screen codes
// straight into the PET's video RAM (lib/petscii.8bs), or reverse-video
// fills and block digits or a printed number through @8bitscript/text
// (lib/draw.8bs) — and the arm a build cannot take folds away.
//
// The element is a call into lib/, and it costs what the inline drawing
// did: a function with one caller is written into it (8bitscript #184).
// Before that rule this form measured +56 bytes on every 6502 and +84 on
// the PET (2048 #51), which is why the drawing used to live here.
import { System } from "@8bitscript/system";
import { paintTile } from "../lib/draw.8bs";
import { stampTile } from "../lib/petscii.8bs";

export component Tile(row: utinyint, col: utinyint, exponent: utinyint) {
    if (#system() == System.PET) {
        stampTile(row, col, exponent);
    } else {
        paintTile(row, col, exponent);
    }
}
