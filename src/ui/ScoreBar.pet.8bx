// The PET's header and status lines, as runs of pre-converted screen codes
// out of lib/tile.pet.8bs's HUD table — no character-set lookup at run
// time, which is what a 4K 2001 can afford. Where each run goes is a
// property of the build (40 or 80 columns), so the unused arm folds away.
import { Video } from "@8bitscript/system";
import { graphicsSet, writeCells, blankCells, printScore5, hud } from "../lib/tile.8bs";

const ROW: usmallint = Video.COLUMNS; // 40, or 80 on an 8032 build

export component ScoreBar(score: usmallint, over: bool, won: bool) {
    graphicsSet();
    let headerAt: usmallint = 2;
    let statusAt: usmallint = 962;
    if (Video.COLUMNS != 40) {
        headerAt = 22;
        statusAt = 1942;
    }
    writeCells(headerAt, hud.TITLE_AT, hud.TITLE_LEN);
    writeCells(
        ROW - hud.SCORE_DIGITS_LEN - hud.SCORE_LABEL_LEN,
        hud.SCORE_LABEL_AT,
        hud.SCORE_LABEL_LEN,
    );
    printScore5(ROW - hud.SCORE_DIGITS_LEN, score);
    // The status line does not announce the end of the game — <GameOver />
    // does — so it goes blank rather than keeping ARROWS TO MOVE up under a
    // board that cannot move.
    if (won) {
        writeCells(statusAt, hud.WON, hud.STATUS_LEN);
    } else if (!over) {
        writeCells(statusAt, hud.ARROWS, hud.STATUS_LEN);
    } else {
        blankCells(statusAt, hud.STATUS_LEN);
    }
}
