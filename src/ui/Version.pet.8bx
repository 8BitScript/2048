// The version, flush right on row 24, as screen codes (V is 22 there, not
// ASCII 118).
import { Video } from "@8bitscript/system";
import { writeCells, hud } from "../lib/tile.8bs";

export component Version() {
    let versionAt: usmallint = 994;
    if (Video.COLUMNS != 40) {
        versionAt = 1994;
    }
    writeCells(versionAt, hud.TITLE_VERSION, hud.TITLE_VERSION_LEN);
}
