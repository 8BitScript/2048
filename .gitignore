# Dependencies (link:-ed straight to the sibling 8bitscript checkout)
node_modules/
.pnpm-store/

# Compiler output
dist/

# Compiled Commodore/Atari/NES program images, if built outside dist/
*.prg
*.xex
*.nes

# Wrangler local state
.wrangler/

# OS cruft
.DS_Store

# Personal hardware — lives in ~/.config/8bitscript/, not the game
8bitscript.controllers.json

# Editor / agent local config (attribution, rules)
.cursor/cli.json
.cursor/rules/

# Editor state (per-developer, not project config — see .vscode/extensions.json for shared recommendations)
.vscode/settings.json
.sonarlint/
