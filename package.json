{
  "name": "2048",
  "version": "0.1.0",
  "private": true,
  "description": "2048, in 8BitScript, from one source file, on the VIC-20, C64, PET, C128, Atari 8-bit, NES, Commander X16, MEGA65, and the web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "start": "8bs run vic20",
    "start:c64": "8bs run c64",
    "start:pet": "8bs run pet",
    "start:c128": "8bs run c128",
    "start:atari8": "8bs run atari8",
    "start:nes": "8bs run nes",
    "start:cx16": "8bs run cx16",
    "start:mega65": "8bs run mega65",
    "start:web": "8bs run web",
    "build": "8bs build --target vic20",
    "build:c64": "8bs build --target c64",
    "build:pet": "8bs build --target pet",
    "build:c128": "8bs build --target c128",
    "build:atari8": "8bs build --target atari8",
    "build:nes": "8bs build --target nes",
    "build:cx16": "8bs build --target cx16",
    "build:mega65": "8bs build --target mega65",
    "build:web": "8bs build --target web",
    "deploy:web": "8bs build --target web && npx wrangler deploy",
    "check": "8bs check src/main.8bs"
  },
  "devDependencies": {
    "@8bitscript/cli": "0.1.2"
  },
  "dependencies": {
    "@8bitscript/screen": "0.1.2",
    "@8bitscript/text": "0.1.2",
    "@8bitscript/input": "0.1.2",
    "@8bitscript/random": "0.1.2",
    "@8bitscript/system": "0.1.2",
    "@8bitscript/vic20": "0.1.2",
    "@8bitscript/c64": "0.1.2",
    "@8bitscript/pet": "0.1.2",
    "@8bitscript/c128": "0.1.2",
    "@8bitscript/atari8": "0.1.2",
    "@8bitscript/nes": "0.1.2",
    "@8bitscript/cx16": "0.1.2",
    "@8bitscript/mega65": "0.1.2",
    "@8bitscript/web": "0.1.2"
  }
}
